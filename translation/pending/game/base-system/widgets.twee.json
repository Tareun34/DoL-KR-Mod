  ],
  "old_kr": [],
  "new_en": [
   "\t\t\t<!--",
   "\t\t\t\t1 mL of nectar = 1 point of $physique.",
   "",
   "\t\t\t\tSince physique(1) = 10 $physique, divide \"change\" by 10.",
