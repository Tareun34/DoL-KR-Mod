   "<<elseif $mines_suspicion gte 80>>",
   "\t<span class=\"pink\">The guards throw searching glances in your direction.</span>",
   "<<elseif $mines_suspicion gte 60>>",
   "\t<span class=\"purple\">The guards eye you warily.</span>",
   "<<elseif $mines_suspicion gte 40>>",
   "\t<span class=\"blue\">The guards are keeping an eye on you.</span>",
   "<<elseif $mines_suspicion gte 20>>",
   "\t<span class=\"lblue\">The guards pay you little attention.</span>",
   "<<elseif $mines_suspicion gte 1>>",
   "\t<span class=\"teal\">The guards don't pay you any attention.</span>",
   "<<else>>",
   "\t<span class=\"green\">You might as well be invisible for all the guards pay attention to you.</span>",
   "<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mines_suspicion\">>",
   "\t<<if _args[0] and $statFreeze isnot true>>",
   "\t\t<<set $mines_suspicion += (_args[0])>>",
   "\t\t<<set $mines_suspicion to Math.clamp($mines_suspicion, 0, 100)>>",
   "\t<</if>>",
   "<</widget>>"
  ],
  "old_kr": [
   "<<widget \"mines_init\">>",
   "<<set $mines_crystals to 10>>",
   "<<if $prof.pickaxe is undefined>>",
   "\t<<set $prof.pickaxe to 0>>",
   "<</if>>",
   "<<set $mines_suspicion to 61>>",
   "<<set $mines_guards_dig to 0>>",
   "<</widget>>",
   "",
   "<<widget \"mines_end\">>",
   "<<unset $mines_crystals>>",
   "<<unset $mines_suspicion>>",
   "<</widget>>",
   "",
   "<<widget \"mines_crystals\">>",
   "<<number $mines_crystals \"silent\">>",
   "<<set $_color to [\"red\",\"pink\",\"purple\",\"purple\",\"blue\",\"blue\",\"lblue\",\"lblue\",\"teal\",\"teal\",\"green\"][Math.clamp($mines_crystals,0,10)]>>",
   "<<set $_count to $mines_crystals gte 1 ? _text_output : \"0\">>",
   "<<set $_crystals to \"수정\">>",
   "당신은 <span @class=\"$_color\">$_count</span>개의 $_crystals【을를】 가지고 있다.",
   "<</widget>>",
   "",
   "<<widget \"passout_mines\">>",
   "<<passout>>",
   "<<link [[다음|Mines Passout]]>><</link>>",
   "<br>",
   "<</widget>>",
   "",
   "<<widget \"mines_suspicion_text\">>",
   "<<if $mines_suspicion gte 100>>",
   "\t<span class=\"red\">경비원들이 당신에게서 눈을 떼지 않는다.</span>",
   "<<elseif $mines_suspicion gte 80>>",
   "\t<span class=\"pink\">경비원들이 샅샅이 뒤지는 듯한 시선을 당신 쪽으로 던진다.</span>",
   "<<elseif $mines_suspicion gte 60>>",
   "\t<span class=\"purple\">경비원들이 경계하는 눈초리로 당신을 살핀다.</span>",
   "<<elseif $mines_suspicion gte 40>>",
   "\t<span class=\"blue\">경비원들이 당신을 주시하고 있다.</span>",
   "<<elseif $mines_suspicion gte 20>>",
   "\t<span class=\"lblue\">경비원들은 당신에게 거의 신경을 쓰지 않는다.</span>",
   "<<elseif $mines_suspicion gte 1>>",
   "\t<span class=\"teal\">경비원들은 당신에게 전혀 신경을 쓰지 않는다.</span>",
   "<<else>>",
   "\t<span class=\"green\">경비원들의 무관심함을 보면, 당신은 아예 투명 인간이나 다름없는 것 같다.</span>",
   "<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mines_suspicion\">>",
   "\t<<if _args[0] and $statFreeze isnot true>>",
   "\t\t<<set $mines_suspicion += (_args[0])>>",
   "\t\t<<set $mines_suspicion to Math.clamp($mines_suspicion, 0, 100)>>",
   "\t<</if>>",
   "<</widget>>"
  ],
  "new_en": [
   "<<widget \"mine_init\">>",
   "\t<<if $prof.pickaxe is undefined>>",
   "\t\t<<set $prof.pickaxe to 0>>",
   "\t<</if>>",
   "\t<<if !$mine>>",
   "\t\t<<set $mine to { hope: 0 }>>",
   "\t\t<<set $mine.bomb to { parts: 0 }>>",
   "\t\t<<set $mine.job to { list: [] }>>",
   "\t\t<<set $mine.job.mining to { shackle: 8 }>>",
   "\t\t<<set $mine.job.cleaning to {}>>",
   "\t\t<<set $mine.favor to {}>>",
   "\t\t<<set $mine.favor.job to {}>>",
   "\t\t<<set $mine.distraction to {}>>",
   "\t\t<<set $mine.setup to {}>>",
   "\t\t<<set $mine.tunnel to {}>>",
   "\t\t<<set $mine.gemPool to []>>",
   "",
   "\t\t<<if $foundMineGem>>",
   "\t\t\t<<unset $foundMineGem>>",
   "\t\t\t<<set $mine.heldGem to \"small gem\">>",
   "\t\t<</if>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_job\">>",
   "\t<<if $mine.job.list.length is 0>>",
   "\t\t<<set $mine.job.list to [\"mining\", \"minecarts\", \"cleaning\"]>>",
   "\t<</if>>",
   "\t<<set $mine.job.current to $mine.job.list.pluck()>>",
   "",
   "\t<<switch $mine.job.current>>",
   "\t\t<<case \"mining\">>",
   "\t\t\t<<He>> leads you through the caves to a large group of slaves, all swinging pickaxes into the rock wall.",
   "\t\t\t<br><br>",
   "\t\t\t<<link [[Next|Mine Job Mining Intro]]>><</link>>",
   "\t\t<<case \"minecarts\">>",
   "\t\t\t<<He>> leads you through the caves to a minecart track. You look up to see a rail on the rock ceiling that goes along the tunnel.",
   "\t\t\t<br><br>",
   "\t\t\t<<link [[Next|Mine Job Minecarts Intro]]>><</link>>",
   "\t\t<<case \"cleaning\">>",
   "\t\t\t<<He>> leads you through the caves and into a large cave filled with guards. One side of the cave is filled with bunk beds, a handful of them have people sleeping in them. The other side is filled with tables.",
   "\t\t\t<br><br>",
   "\t\t\t<<link [[Next|Mine Job Cleaning Intro]]>><</link>>",
   "\t\t<<default>>",
   "\t\t\tPlease Report this Error in the #bug-reports channel of the Degrees of Lewdity Discord Server ",
   "\t<</switch>>",
   "<</widget>>",
   "",
   "<<widget \"mine_job_link\">>",
   "\t<<set _job_link to `Mine Job ${$mine.job.current.toLocaleUpperFirst()} Intro`>>",
   "",
   "\t<<if $mine.job.current is \"mining\">>",
   "\t\t<<set _job_link to `Mine Job Mining Return`>>",
   "\t<</if>>",
   "",
   "\t<<link [[Next|_job_link]]>><</link>>",
   "<</widget>>",
   "",
   "<<widget \"mine_distract_links\">>",
   "\t<<if Time.hour lt 6>>",
   "\t\t<<set _today to true>>",
   "\t<</if>>",
   "",
   "\t<<link [[<<print _today ? \"Today\" : \"Tomorrow\">>|_args[0]]]>><<set $phase to _today ? 0 : 1>><</link>>",
   "\t<br>",
   "\t<<link [[<<print _today ? \"Tomorrow\" : \"In two days\">>|_args[0]]]>><<set $phase to _today ? 1 : 2>><</link>>",
   "\t<br>",
   "\t<<link [[<<print _today ? \"In two days\" : \"In three days\">>|_args[0]]]>><<set $phase to _today ? 2 : 3>><</link>>",
   "\t<br>",
   "\t<<link [[<<print _today ? \"In three days\" : \"In four days\">>|_args[0]]]>><<set $phase to _today ? 3 : 4>><</link>>",
   "\t<br>",
   "\t<<link [[Nevermind|_args[0]]]>><<set $phase to \"no\">><</link>>",
   "<</widget>>",
   "",
   "<<widget \"mine_distract_time\">>",
   "\t<<if Time.hour lt 6>>",
   "\t\t<<set _today to true>>",
   "\t<</if>>",
   "",
   "\t<<switch $phase>>",
   "\t\t<<case 0>>",
   "\t\t\t<<set _time to \"today\">>",
   "\t\t<<case 1>>",
   "\t\t\t<<set _time to \"tomorrow\">>",
   "\t\t<<case 2>>",
   "\t\t\t<<set _time to \"in two days\">>",
   "\t\t<<case 3>>",
   "\t\t\t<<set _time to \"in three days\">>",
   "\t\t<<case 4>>",
   "\t\t\t<<set _time to \"in four days\">>",
   "\t<</switch>>",
   "",
   "\t<<print _time>>",
   "<</widget>>",
   "",
   "<<widget \"mine_distract_check\">>",
   "\t<<set _distraction_count to 0>>",
   "\t<<if $mine.distraction.minecarts is 0>><<set _distraction_count += 1>><</if>>",
   "\t<<if $mine.distraction.mining is 0>><<set _distraction_count += 1>><</if>>",
   "\t<<if $mine.distraction.night is 0>><<set _distraction_count += 1>><</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_night_task\">>",
   "\t<<set $mine.distraction.night to \"inprogress\">>",
   "\t<<switch random(1,3)>>",
   "\t\t<<case 1>>",
   "\t\t\t<<set $mine.favor.job.night to \"gem\">>",
   "\t\t\t\"I need a gem or a crystal, doesn't matter which.\"",
   "\t\t<<case 2>>",
   "\t\t\t<<set $mine.favor.job.night to \"note\">>",
   "\t\t\t<<He>> hands you a piece of paper. \"I need you to give this to a person wearing a boiler suit with a diamond painted on it.\"",
   "\t\t<<case 3>>",
   "\t\t\t<<set $mine.favor.job.night to \"firework\">>",
   "\t\t\t<<He>> hands you some fireworks. \"I need you to set these fireworks off next to a guard. I wish I could see their face when it goes off. Don't ask where I got these.\"",
   "\t\t<<default>>",
   "\t\t\t\"I need you to make a report in the bug reports channel in the Degrees of Lewdity discord server,\" <<he>> says. \"Make sure to include a screenshot and a save file,\"",
   "\t\t\t<<he>> starts to walk away before remembering something. \"Just one more thing, make sure you're on the most recent version. Send James my regards.\"",
   "\t<</switch>>",
   "<</widget>>",
   "",
   "<<widget \"mine_hope\">>",
   "\t<<if !isNaN(T.args[0])>>",
   "\t\t<<set $mine.hope to Math.clamp(V.mine.hope + _args[0], 0, 50)>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_pregnancy\">>",
   "\tYou stumble towards the exit and barely reach the street before collapsing, your consciousness fading away.",
   "\t<br><br>",
   "\t<<link [[Next|Pregnancy Birth Hospital]]>><<set $stress -= 5000>><<endevent>><<set $phase to 1>><</link>>",
   "<</widget>>",
   "",
   "<<widget \"mine_passout\">>",
   "\tYou've pushed yourself too much.",
   "\t<br><br>",
   "",
   "\t<<passout>>",
   "\t<<link [[Everything fades to black...|Mine Passout]]>><<endevent>><</link>>",
   "<</widget>>",
   "",
   "<<widget \"mine_gem\">>",
   "\t<<if $mine.gemPool.length is 0>>",
   "\t\t<<run",
   "\t\t\tfor (let i = 0; i < 9; i++) V.mine.gemPool.push(1);",
   "",
   "\t\t\tlet gem_count = 6;",
   "\t\t\tif (V.prof.pickaxe < 300) gem_count = 8;",
   "\t\t\tfor (let i = 0; i < gem_count; i++) V.mine.gemPool.push(2);",
   "",
   "\t\t\tgem_count = 3;",
   "\t\t\tif (V.prof.pickaxe < 650) gem_count = 5;",
   "\t\t\tfor (let i = 0; i < gem_count; i++) V.mine.gemPool.push(3);",
   "\t\t>>",
   "\t<</if>>",
   "",
   "\t<<set _gem to $mine.gemPool.pluck()>>",
   "\t<<set _gem_diff_min to [0, 300, 650][_gem-1]>>",
   "\t<<set _gem_diff_max to [299, 649, 1000][_gem-1]>>",
   "<</widget>>",
   "",
   "<<widget \"mine_gem_collect\">>",
   "\t<<mine_gem_check _args[0]>>",
   "\t<<set _gemType to either(\"gem\", \"crystal\")>>",
   "\t<<set $mine.heldGem to `${_gemSize} ${_gemType}`>>",
   "\ta $mine.heldGem. It might be worth something on the black market.",
   "\t<<mine_gem_value>>",
   "\t<<set $blackmoney += _gem_value>>",
   "<</widget>>",
   "",
   "<<widget \"mine_gem_value\">>",
   "\t<<set _gem_value to 0>>",
   "\t<<if $mine.heldGem.includes(\"small\")>>",
   "\t\t<<set _gem_value to 400>>",
   "\t<<elseif $mine.heldGem.includes(\"medium\")>>",
   "\t\t<<set _gem_value to 800>>",
   "\t<<elseif $mine.heldGem.includes(\"large\")>>",
   "\t\t<<set _gem_value to 1600>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_gem_check\">>",
   "\t<<switch _args[0]>>",
   "\t\t<<case 1>>",
   "\t\t\t<<set _gemSize to \"small\">>",
   "\t\t<<case 2>>",
   "\t\t\t<<set _gemSize to \"medium\">>",
   "\t\t<<case 3>>",
   "\t\t\t<<set _gemSize to \"large\">>",
   "\t<</switch>>",
   "<</widget>>",
   "",
   "<<widget \"mine_pit\">>",
   "\t<<set _pits to [\"Nothing\"]>>",
   "\t<<set _coveredPits to 0>>",
   "\t<<if $settings.slimesEnabled and $hallucinations gte 1>>",
   "\t\t<<set _pits.push(\"Slimes\")>>",
   "\t<<else>>",
   "\t\t<<set _coveredPits++>>",
   "\t<</if>>",
   "\t<<if $settings.tentaclesEnabled and $hallucinations gte 2>>",
   "\t\t<<set _pits.push(\"Tentacles\")>>",
   "\t<<else>>",
   "\t\t<<set _coveredPits++>>",
   "\t<</if>>",
   "\t<<if $settings.swarmsEnabled and $settings.spidersEnabled>>",
   "\t\t<<set _pits.push(\"Spiders\")>>",
   "\t<<else>>",
   "\t\t<<set _coveredPits++>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_punishment_end\">>",
   "\t<<if isPregnancyEnding()>>",
   "\t\t\"I hope you learned your lesson down–\" <<He>> realizes you're in labour. <<He>> grabs you and picks you up as you slip from consciousness.",
   "\t\t<br><br>",
   "\t\t<<link [[Next|Mine Birth]]>><</link>>",
   "\t<<else>>",
   "\t\t\"I hope you learned your lesson down there,\" <<he>> chuckles before dragging you away.",
   "\t\t<br><br>",
   "\t\t<<if Time.hour lte 5 or Time.hour gte 21>>",
   "\t\t\t<<He>> pulls you to the sleeping area. The guard in front of it opens it up. The <<person>> pushes you through. The gate slams and locks behind you.",
   "\t\t\t<br><br>",
   "\t\t\t<<link [[Next|Mine Night]]>><<endevent>><</link>>",
   "\t\t<<else>>",
   "\t\t\t<<He>> pulls you in front of another guard. \"Deal with this trash,\" <<he>> says.",
   "\t\t\t<br><br>",
   "\t\t\t<<mine_job_link>>",
   "\t\t<</if>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_maze_map\">>",
   "\t<<for _i to 0; _i lt MineMaze.MAZE_SIZE; _i++>>",
   "\t\t<<for _j to 0; _j lt MineMaze.MAZE_SIZE; _j++>>",
   "\t\t\t<<if $mine.maze.PC.x is _j and $mine.maze.PC.y is _i>>",
   "\t\t\t\t<<print \"P \">>",
   "\t\t\t<<elseif $mine.maze.Exit.x is _j and $mine.maze.Exit.y is _i>>",
   "\t\t\t\t<<print \"E \">>",
   "\t\t\t<<else>>",
   "\t\t\t\t<<set _guard_count to 0>>",
   "\t\t\t\t<<for _k to 0; _k lt $mine.maze.Guards.length; _k++>>",
   "\t\t\t\t\t<<if $mine.maze.Guards[_k].Location.x is _j and $mine.maze.Guards[_k].Location.y is _i>>",
   "\t\t\t\t\t\t<<set _guard_count++>>",
   "\t\t\t\t\t<</if>>",
   "\t\t\t\t<</for>>",
   "\t\t\t\t<<if _guard_count isnot 0>>",
   "\t\t\t\t\t<<print `${_guard_count} `>>",
   "\t\t\t\t<<else>>",
   "\t\t\t\t\t<<print \"_ \">>",
   "\t\t\t\t<</if>>",
   "\t\t\t<</if>>",
   "\t\t<</for>>",
   "\t\t<br>",
   "\t<</for>>",
   "<</widget>>",
   "",
   "<<widget \"mine_unshackle\">>",
   "\t<<set $mine.job.mining.shackle to 8>>",
   "\t<<unbind>>",
   "<</widget>>",
   "",
   "<<widget \"mine_shackle_text\">>",
   "\t<<if $mine.job.mining.shackle gte 7>>",
   "\t\t<span class=\"red\">Your shackles are very sturdy.</span>",
   "\t<<elseif $mine.job.mining.shackle gte 4>>",
   "\t\t<span class=\"blue\">Your shackles are dented.</span>",
   "\t<<elseif $mine.job.mining.shackle gte 2>>",
   "\t\t<span class=\"blue\">Your shackles are cracked.</span>",
   "\t<<else>>",
   "\t\t<span class=\"blue\">Your shackles look like they could break at any moment</span>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"mine_orgasm\">>",
   "\t<br><br>",
   "\t<<orgasm>>",
   "\tYour moans echo through the tunnels.",
   "<</widget>>",
   "",
   "<<widget \"mine_links\">>",
   "\t<<icon \"actions/explore.png\">><<link [[Continue exploring (0:30)|Mine Explore]]>><<pass 30>><<endevent>><</link>>",
   "\t<br>",
   "\t<<icon \"get-out.png\">><<link [[Return to the entrance|Mine]]>><<endevent>><</link>>",
   "<</widget>>"
  ],
  "context": ":: Widgets Mines [widget]"
 }
]
