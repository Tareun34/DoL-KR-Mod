	<<promiscuity3>>
<</widget>>

<<widget "receivephallusdata">>
	<<set $sciencephallus += 1>>
	<<if $NPCList[$index].penis isnot "none">>
		<<set $sciencephalluspenis += 1>>
	<<else>>
		<<set $sciencephallusclit += 1>>
	<</if>>
	<span class="gold">측정한 <<personpenis>> 치수는 방이나 학교 도서관에서 프로젝트에 추가할 수 있습니다.</span>
<</widget>>

<<widget "bloodmoonTourist1">>
	You see a trio gazing at the red moon in the distance. You catch a bit of their conversation.
	<br><br>
	"It's strange how they get blood moons every month here, right?"<br>
	"It's just light pollution."<br>
	"Or... What if it's something supernatural?"<br>
	"Don't be absurd."
<</widget>>

<<widget "bloodmoonTourist2">>
	You see a couple gazing at the red moon in the distance. You catch a bit of their conversation.
	<br><br>
	"How romantic. If I lived here, I'd come to look at this sight every time."<br>
	"You'd probably get sick of it rather quickly."<br>
	"Do you have any romantic bone in your body?"
<</widget>>

<<widget "bloodmoonTourist3">>
	You see a group gazing at the red moon in the distance. You catch a bit of their conversation.
	<br><br>
	"Oh, what the hell is that-"<br>
	"Wow, that's amazing!"<br>
	"Didn't expect this place to have anything pretty to look at beyond the people."<br>
	"Don't look at it for too long, you're so drunk that you might lose your balance tilting your neck so far up."
<</widget>>

<<widget "bloodmoonTourist4">>
	You see a couple gazing at the red moon in the distance. You catch a bit of their conversation.
	<br><br>
	"Look at that. See, I told you the brochure was right!"<br>
	"Uh. Wow."<br>
	"I don't know why you keep insisting that I'm always wrong-"<br>
	"Oh, shut it."
<</widget>>


<<widget "bloodmoonTouristBeach">>
	<<if random(0,10) is 0>>
		<<cleareventpool>>
		<<addevent "bloodmoonTourist1">>
		<<addevent "bloodmoonTourist2">>
		<<addevent "bloodmoonTourist3">>
		<<addevent "bloodmoonTourist4">>
		<<runeventpool>>
		<br><br>
	<</if>>
<</widget>>


:: Widgets Events Beach [widget]
<<widget "eventsbeach">>
	<<cleareventpool>>
	<<if Time.dayState is "night">>
		<<addevent "beachNightDog" 15>>
		<<addevent "beachNightAmbush" 15>>
		<<addevent "beachDayWind" 70>>
	<<elseif $exposed gte 1>>
		<<addevent "beachExposedNoticed" 80>>
		<<addevent "beachExposedMolestation" 20>>
	<<else>>
		<<addevent "beachDayTackle" 10>>
		<<if !$worn.lower.type.includes("naked")>>
			<<addevent "beachDayDogTug" 10>>
		<</if>>
		<<addevent "beachDayParent" 30>>
