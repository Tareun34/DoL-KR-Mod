   "\t\t].flat().forEach(npc => {",
   "\t\t\tif (!npc) return;",
   "\t\t\tif (npc.skincolour === \"ghost\") { npc.skinType = \"ghost\"; delete npc.skincolour; }",
   "\t\t\telse if (npc.skincolour === \"white\") npc.skincolour = 0;",
