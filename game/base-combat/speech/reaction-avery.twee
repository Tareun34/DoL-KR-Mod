:: Widgets reaction-Avery [widget]

<<widget "reaction-avery-kissImminent">>
	<<his>> 눈길이 노골적인 갈망을 품은 채 당신의 입술과 눈 사이를 오간다. <<if C.npc.Avery.rage lt 20>>"이리 와요, <<pcpetname "Avery">>..."<</if>>
<</widget>>

<<widget "reaction-avery-kissSkin">>
	<<set _bodyPart to _args[0]>>

	<<if _bodyPart is "forehead">>
		<<if C.npc.Avery.love gte 60 and C.npc.Avery.rage lt 20 and $enemytrust gt 60>>
			"착하기도 하지, <<pcpetname "Avery" "my">>," <<he>>【이가】 당신의 살결에 속삭인다.
		<</if>>
	<<else>>
		<<he>>【이가】 당신의 <<if _bodyPart is "chest">><<chest>>에<<elseif _bodyPart is "bottom">><<bottom>>에<<else>>허벅지에<</if>> 공을 들이며 애무하는 중간중간, <<= C.npc.Avery.rage gte 60 ? "거칠게 꼬집고 깨무는 행위가" : C.npc.Avery.rage gte 20 ? "깨물고 빨아들이는 행위가" : "살짝 꼬집고 가끔 깨무는 행위가">> 섞여든다. <<= $awareness gte 100 ? "분명 자국을 남기려는 것이다." : "마치 자국을 남기려는 것만 같다.">>
	<</if>>
<</widget>>

<<widget "reaction-avery-fondle">>
	<<if !_avery_fondle_speech>>
		<<set _bodyPart to _args[0]>>

		<<if $consensual or (!$consensual and $enemyanger lte 20)>>
			<<set _avery_fondle_speech to 1>>
			<<switch _bodyPart>>
				<<case "chest" "breasts">>
					"당신의 <<chestsimple>>【은는】 <<= $player.breastsize gte 5 ? "너무 부드러워서," : $player.breastsize gte 1 ? "기분 좋게 한 손에 꽉 차서," : "정말 매끄러워서, 유두를">> 가지고 놀기 참 좋군요..."
				<<case "bottom">>
					"정말 <<= $player.bottomsize gte 6 ? "부드러운" : $player.bottomsize gte 3 ? "멋진" : "사랑스러운">> <<bottomsimple>>【을를】 가졌군요."
			<</switch>>
		<</if>>
	<</if>>
<</widget>>

<<widget "reaction-avery-initiative">>
	<<if C.npc.Avery.rage gte 60>>
		<<he>>【은는】 <<= either("코웃음을 친다","한숨을 내쉰다","눈을 굴린다")>>. "먼저 나서겠다는 건가? 그래도 자기가 무슨 용도인지는 알고 있나 보네."
	<<else>>
		<<he>>【은는】 <<= $averyragerevealed is 1 ? "비웃음을 흘린다" : "미소를 짓는다">>. "먼저 나서겠다는 건가요?" <<he>>【은는】 <<= $averyragerevealed is 1 ? "재미있다는" : "흡족한">> 기색이다.
	<</if>>
<</widget>>

<<widget "reaction-avery-undress">>
	<<if C.npc.Avery.rage gte 60>>
		<<he>>【이가】 당신을 향해 눈을 가늘게 뜬다. "내가 지시하기 전까지는 손대지 말고 가만히 있어."
	<<else>>
		<<print either(
			`<<he>>【이가】 웃음을 터뜨린다. "우리 둘 다 시간을 아껴 보자는 건가요, 응?"`,
			`<<he>>【이가】 양 눈썹을 치켜올린다. "이런, 정말 대담하기도 하지, <<pcpetname "Avery">>."`
		)>>
	<</if>>
<</widget>>

<<widget "reaction-avery-choke">>
	<<if _daddy>>
		<<rng>>
		<<if $rng lte 20>>
			<<He>>【이가】 <<laughs>>. "목이 졸린 채로도 여전히 <<nnpc_mummy "Avery">>【을를】 애원할 수 있는지 볼까?"
		<<elseif C.npc.Avery.rage gte 60>>
			"원하는 걸 주지," <<he>>【이가】 낮게 읊조린다. "하지만 자기가 애원해서 주는 건 아니야." 목을 쥔 <<his>> 손에 조금 더 힘이 들어간다.
		<<elseif C.npc.Avery.rage gte 20>>
			"그래야지, <<pcpetname "Avery">>." <<his>> 손이 목을 조금 더 강하게 죄어오며 <<he>>【이가】 <<laughs>>. "이제야 나한테 어떻게 말해야 하는지 아는군."
		<<else>>
			"원하시는 대로요, <<pcpetname "Avery">>," <<he>>【이가】 기분 좋게 갸르릉거린다. "<<nnpc_mummy "Avery">>에게 맡겨요."
		<</if>>
	<</if>>
<</widget>>

/* PC lines (plead / demand / forgive / moan). */

<<widget "pc-line-avery-plead">>
	<<if !$avery_mansion>>
		<<addPairedSpeechLine "Avery" "plead">>
			<<pcLine>>"이 데이트는 전부 이걸 위한 거였어요...?"
		<<npcLine>>
			<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
				<<He>>【이가】 코웃음을 친다. "네가 더 나은 대접을 받을 자격이 있다고 생각해? 넌 딱 내가 주는 만큼만 받을 자격이 있어."
			<<else>>
				<<He>>【이가】 웃는다. "뭘 기대한 거죠, <<pcpetname "Avery">>? <<= either("동화 같은 이야기","내 인내심이 끝없기를")>>?"
			<</if>>
		<</addPairedSpeechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"죄송해요! 그럴 생각은 아니었어요!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"내 지능을 모욕하지 마," <<he>>【이가】 으르렁거린다. "자기가 무슨 짓을 하는지 정확히 알고 있었잖아!"
				<<else>>
					"이제 조용히 해요. 착한 <<girl>>답게 벌을 받아들이도록 해요."
				<</if>>
			<</addPairedSpeechLine>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"제발요, 더 잘할게요! 약속해요...!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"'더 잘하는' 건 내가 널 제대로 길들인 다음의 일이야!"
				<<else>>
					"더 잘하게 될 거예요. 내가 직접 확실히 해 둘 테니까." <<He>>【이가】 차갑게 미소 짓는다.
				<</if>>
			<</addPairedSpeechLine>>
		<<elseif $averyromance>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"사랑해요, 에이버리. 제발 나한테 이러지 말아요!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"감히 그 단어로 날 조종하려 들지 마," <<he>>【이가】 내뱉는다.
				<<else>>
					<<He>>【이가】 비웃는다. "정말로 날 사랑했다면, 내게 거역하지 않았겠죠."
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "plead">>
				<<pcLine>>"죄송해요, 에이버리, 제발 용서해 주세요...!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gte 20>>
					"네 빌어먹을 사과 따윈 필요 없어, 내가 원하는 건 복종이야!"
				<<else>>
					"이것 봐요, 착한 애완동물처럼 내 밑에서 움츠러들고 있네요. 안타깝게도 오늘은 좀 무자비해지고 싶은 기분이라서," <<he>>【이가】 갸르릉거린다.
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-demand">>
	<<if !$avery_mansion>>
		<<addPairedSpeechLine "Avery" "demand">>
			<<pcLine>>"이런 취급을 받을 만큼 돈을 주는 것도 아니잖아요!"
		<<npcLine>>
			<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
				"감히 나한테 돈 얘기를 꺼내, 이 탐욕스러운 창녀 주제에!"
			<<else>>
				<<His>> 눈이 가늘어진다. "이렇게 굴면서 더 달라고 요구하다니, 배짱이 대단하군요."
			<</if>>
		<</addPairedSpeechLine>>
	<<else>>
		<<if isAveryHuntingPlayer()>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"저리 떨어져요! 너무 지나쳐요, 에이버리!"
			<<npcLine>>
				"너한테는 지나친 게 없지!" <<he>>【이가】 <<= either("내뱉는다","성난 목소리로 쉭쉭거린다","으르렁거린다")>>. "넌 내가 해 주는 걸 하나도 고마워할 줄 모르니까!<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>> 뭘 해 줘도 성에 안 차지!<</if>>"
			<</addPairedSpeechLine>>
		<<elseif $averyromance>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"사랑한다고 말했지만, 당장 그만두지 않으면 망설임 없이 떠날 거예요!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<His>> 표정이 분노로 일그러진다. "내가 널 위해 해 준 게 얼만데, 아직도 그 <<= either("시궁창","지옥 같은 곳")>>이 나와 함께 있는 것보다 낫다고 생각한단 말이야?"
				<<else>>
					<<His>> 표정이 굳어진다. "그 비참한 삶에서 벗어날 기회를 줬는데, 그걸 내 얼굴에 도로 집어던지겠다고요?"
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "demand">>
				<<pcLine>>"그만해요, 에이버리! 난<<if $averySeen.includes("walkParkSOYes") or $averyromance>> 당신의 <<girlfriend>>지,<</if>> 당신 샌드백이 아니에요!"
			<<npcLine>>
				<<if C.npc.Avery.rage gte 20 or $enemyanger gt 20>>
					<<He>>【이가】 비웃듯 웃는다. "연인 행세를 하고 싶어? 그럼 복종부터 배워!"
				<<else>>
					"잘못을 저질렀을 때 호칭 따위가 벌을 면해 주진 않아요."
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-forgive">>
	<<if $avery_fate is undefined>>
		<<addSpeechLine "forgive">>
			"그냥 화가 난 것뿐이에요," 당신이 말한다. "누구나 가끔은 화를 내잖아요. 용서할게요."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "forgive">>
			"이제 왜 그렇게 화를 내는지 알겠어요, 에이버리," 당신이 말한다. "그리고 용서할게요."
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-avery-moan">>
	<<set _daddy to $submissive gte 1150 and random(1, 4) is 1>>
	<<if $avery_fate is "ascended">>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"전 전부 당신 거예요, 하운드."
		<<npcLine>>
			<<if $consensual>>
				<<if C.npc.Avery.rage gte 60 >>
					<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래, 그렇지." <<He>>【이가】 거만하게 <<= either("코웃음을 친다","콧김을 내뿜는다")>>. "자기 분수를 아는 건 좋은 일이야, 내 작은 여우."
				<<elseif C.npc.Avery.rage gte 20>>
					<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래, 그렇지?" <<He>>【이가】 만족스럽게 씩 웃는다. "자기 분수를 아는 건 좋은 일이지, 내 작은 여우..."
				<<else>>
					<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래요... 그렇죠." <<He>>【이가】 만족스럽게 <<laughs>>. "자기 분수를 알고 있다니 기쁘네요, 내 작은 여우."
				<</if>>
			<<elseif C.npc.Avery.rage gte 60 >>
				<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래, 그렇지." <<He>>【이가】 거만하게 <<= either("코웃음을 친다","콧김을 내뿜는다")>>. "그럼 그렇게 행동해!"
			<<elseif C.npc.Avery.rage gte 20>>
				<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래, 그렇지?" <<He>>【이가】 만족스럽게 씩 웃는다. "그럼 그에 맞게 행동하는 게 좋을 거야, <<girl>>."
			<<else>>
				<<His>> 눈이 잠시 커지더니, 이내 욕망으로 어두워진다. "그래요... 그렇죠." <<He>>【이가】 만족스럽게 <<laughs>>. "그럼 그에 맞게 행동하는 게 좋을 거예요, <<pcpetname "Avery">>."
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif $averyromance>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"사랑해요, 에이버리."
		<<npcLine>>
			<<if C.npc.Avery.rage gte 60 >>
				<<He>>【이가】 코웃음을 친다. "그래? 요즘 하도 못되게 굴어서, 깜빡 속을 뻔했네."
			<<elseif C.npc.Avery.rage gte 20>>
				<<He>>【이가】 씩 웃는다. "알아. 그래도 얼마든지 다시 말해 봐."
			<<else>>
				<<He>>【이가】 <<= either("미소 짓는다","<<laughs>>")>>. "알아요. 사랑스럽네요."
			<</if>>
			<<if !$averyUniqueComments.includes("moan_romance")>>
				<<set $averyUniqueComments.pushUnique("moan_romance")>>
				<<npcincr Avery rage -1>><<larage>>
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif _daddy>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"제 분수를 알게 해 주세요, <<nnpc_mummy "Avery">>."
		<<npcLine>>
			<<set $averyUniqueComments.pushUnique("called_daddy")>>
			<<His>> 눈이 잠시 커지지만, 이내 <<he>>【은는】 씩 웃는다. 당신이 <<him>>【을를】 "<<nnpc_mummy "Avery">>"라고 부르는 소리가 마음에 든 모양이다.
			<<if $consensual>>
				<<if C.npc.Avery.rage gte 60 >>
					"오, 분수를 알게 해 주고말고. <<nnpc_Mummy "Avery">>【은는】 널 제대로 벌줄 날만 기다려 왔으니까."
				<<elseif C.npc.Avery.rage gte 20>>
					<<He>>【이가】 다 안다는 듯 미소 짓는다. "<<nnpc_mummy "Avery">>【이가】 네 분수를 알게 해 주길 바라는 거야? 관심을 끌려고 말썽을 부려 온 건지도 모르겠네."
				<<else>>
					<<He>>【이가】 낄낄 웃는다. "음. 날 그렇게 부르는 거 정말 좋아요. 걱정 말아요, <<nnpc_mummy "Avery">>【이가】 잘 돌봐 줄 테니까."
				<</if>>
			<<elseif C.npc.Avery.rage gte 60 >>
				<<He>>【이가】 비웃는다. "오, 그럴 생각이야. <<nnpc_mummy "Avery">>【이가】 네가 있을 곳이 정확히 어딘지 일깨워 줄 테니까."
			<<elseif C.npc.Avery.rage gte 20>>
				"<<nnpc_mummy "Avery">>의 손길이 그렇게 탐나서 말썽을 부린 거야? 기꺼이 네가 있을 곳이 어딘지 보여 주지."
			<<else>>
				"<<nnpc_mummy "Avery">>【이가】 분수를 알게 해 주길 바라는 건가요? 내 손을 쓰게 만드는 대신 그냥 공손하게 부탁하면 됐을 텐데."
			<</if>>
		<</addPairedSpeechLine>>
	<<elseif isLoveInterest("Avery")>>
		<<if !$avery_mansion>>
			<<addPairedSpeechLine "Avery" "moan">>
				<<pcLine>>"그곳에서 절 데리고 나가 주세요, 당신과 함께 데려가 주세요."
			<<npcLine>>
				<<if C.npc.Avery.rage gte 60 >>
					"유감이군. 나랑은 아무 상관도 하고 싶지 않다고 했던 걸로 기억하는데."
				<<elseif C.npc.Avery.rage gte 20>>
					"다시 한번 부탁하게 만들어야겠어. 절박할 때 훨씬 달콤하게 들리거든."
				<<else>>
					<<He>>【이가】 장난스럽게 미소 짓는다. "음. 집에서 날 기다리고 있으면 꽤 사랑스러울 것 같네요."
				<</if>>
			<</addPairedSpeechLine>>
		<<else>>
			<<addPairedSpeechLine "Avery" "moan">>
				<<pcLine>>"제가 얼마나 감사한지 보여 드릴게요, 원하시는 만큼 절 써 주세요."
			<<npcLine>>
				<<if C.npc.Avery.rage gte 60 >>
					"이 갑작스러운 감사의 마음이 오래가길 바라지. 요즘 네 행실은 도저히 봐줄 수 없는 수준이었으니까."
				<<elseif C.npc.Avery.rage gte 20>>
					"계속 이렇게만 하면 불평할 게 거의 없어지겠군. 그게 네가 바라는 거지, 안 그래?"
				<<else>>
					<<He>>【이가】 씩 웃는다. "완벽한 대답이에요. 자, 그 예쁘장한 제안을 써먹어 볼까요."
				<</if>>
			<</addPairedSpeechLine>>
		<</if>>
	<<else>>
		<<addPairedSpeechLine "Avery" "moan">>
			<<pcLine>>"당신은 어떤 보수보다도 소중해요."
		<<npcLine>>
			<<if C.npc.Avery.rage gte 60 >>
				<<He>>【이가】 코웃음을 친다. "그래? 요즘 네 행실을 보면, 도무지 믿기 어렵군."
			<<elseif C.npc.Avery.rage gte 20>>
				<<He>>【이가】 씩 웃는다. "알아. 그래도 네가 얌전히 구는 한, 돈은 계속 들어올 거야, <<pcpetname "Avery">>."
			<<else>>
				<<He>>【이가】 <<= either("미소 짓는다","<<laughs>>")>>. "그렇게 느끼나요? 사랑스럽기도 하지."
			<</if>>
		<</addPairedSpeechLine>>
	<</if>>
<</widget>>
