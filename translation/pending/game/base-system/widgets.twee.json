  "old_en": [],
  "old_kr": [],
  "new_en": [
   "<</widget>>",
   "",
   "<<widget \"relation-box-collapsed\">>",
   "\t<<silently>>",
   "\t\t<<set _npcData = _args[0]>>",
   "\t\t<<set _npcOverrides = _args[1]>>",
   "",
   "\t\t<<script>>",
   "\t\t\tlet npcStats;",
   "\t\t\tif (T.npcOverrides.important) {",
   "\t\t\t\tnpcStats = T.importantNpcStats;",
   "\t\t\t\tT.collapsedStatSlots = 4;",
   "\t\t\t} else {",
   "\t\t\t\tnpcStats = T.otherNpcStats;",
   "\t\t\t\tT.collapsedStatSlots = 2;",
   "\t\t\t}",
   "",
   "\t\t\tT.collapsedVisibleStats = npcStats",
   "\t\t\t\t.filter(function(stat) { return T.npcData[stat] > 0 && T.checkRequirements(stat); })",
   "\t\t\t\t.map(function(stat) {",
   "\t\t\t\t\tlet config = T.getStatConfig(stat);",
   "\t\t\t\t\tlet min = config.minValue || 0;",
   "\t\t\t\t\tlet max = config.maxValue || 100;",
   "\t\t\t\t\tlet icon = config.activeIcon;",
   "\t\t\t\t\tlet name = \"\";",
   "\t\t\t\t\tswitch (config.name) {",
   "\t\t\t\t\t\tcase \"Respect\":",
   "\t\t\t\t\t\tcase \"Affection\":",
   "\t\t\t\t\t\tcase \"Interest\": name = \"Lo\"; break;",
   "\t\t\t\t\t\tcase \"Confidence\": name = \"Cd\"; break;",
   "\t\t\t\t\t\tcase \"Corruption\": name = \"Cr\"; break;",
   "\t\t\t\t\t\tcase \"Rage\": name = \"Rg\"; break;",
   "\t\t\t\t\t\tcase \"Yearning\": name = \"Yr\"; break;",
   "\t\t\t\t\t\tcase \"Wolf Pack Harmony\": name = \"Hm\"; break;",
   "\t\t\t\t\t\tcase \"Wolf Pack Ferocity\": name = \"Fr\"; break;",
   "\t\t\t\t\t\tdefault: name = config.name.slice(0, 2);",
   "\t\t\t\t\t};",
   "\t\t\t\t\treturn {",
   "\t\t\t\t\t\tname : (stat === \"love\" && T.loveInterest ? \"<span class='lewd'><b>\" + name + \"</b></span>\" : name),",
   "\t\t\t\t\t\tactiveIcon : (stat === \"love\" && T.loveInterest ? \"img/ui/love-interest.png\" : icon),",
   "\t\t\t\t\t\tprogress : Math.clamp(Math.round(100*((config.value - min) / (max - min))), 0, 100)",
   "\t\t\t\t\t};",
   "\t\t\t\t})",
   "\t\t\t\t.slice(0, T.collapsedStatSlots);",
   "\t\t<</script>>",
   "\t<</silently>>",
   "\t<div class=\"relation-box-collapsed\" onclick=\"toggleRelationCollapse(this)\">",
   "\t\t<span class=\"relation-box-collapsed-name\">_npcData.nam</span>",
   "\t\t<span class=\"relation-box-collapsed-stats\">",
   "\t\t\t<<for _ci = 0; _ci lt _collapsedStatSlots; _ci++>>",
   "\t\t\t\t<<if _ci lt _collapsedVisibleStats.length>>",
   "\t\t\t\t\t<span class=\"relation-box-collapsed-icon-pair\">",
   "\t\t\t\t\t\t<<if $options.images>>",
   "\t\t\t\t\t\t\t<img class=\"relation-box-collapsed-icon\" @src=\"_collapsedVisibleStats[_ci].activeIcon\">",
   "\t\t\t\t\t\t\t<span>_collapsedVisibleStats[_ci].progress</span>",
   "\t\t\t\t\t\t<<else>>",
   "\t\t\t\t\t\t\t<span class=\"relation-box-collapsed-icon\">_collapsedVisibleStats[_ci].name</span>",
   "\t\t\t\t\t\t\t<small>_collapsedVisibleStats[_ci].progress</small>",
   "\t\t\t\t\t\t<</if>>",
   "\t\t\t\t\t</span>",
   "\t\t\t\t<<else>>",
   "\t\t\t\t\t<span class=\"relation-box-collapsed-icon-pair\"></span>",
   "\t\t\t\t<</if>>",
   "\t\t\t<</for>>",
   "\t\t</span>",
   "\t</div>"
  ],
  "context": "\t<</if>>"
 },
