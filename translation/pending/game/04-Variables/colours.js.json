   "\t},",
   "\t/*",
   "\t * CSS filter for an NPC's skin tone, used by icons rather than the canvas.",
   "\t */",
   "\tgetSkinToneCSSFilter(npc) {",
   "\t\tif (npc.skinType === \"ghost\") return setup.colours.getSkinCSSFilter(\"wraith\", 0);",
   "\t\treturn setup.colours.getSkinCSSFilter(\"gyaru\", npc.skincolour ?? 70);",
   "\t},",
   "\tonSkinToneRangeInput(el) {",
   "\t\tconst box = el.closest(\".skinToneRange\");",
   "\t\tconst handle = {};",
   "\t\tbox.querySelectorAll(\"[data-skin]\").forEach(i => (handle[i.dataset.skin] = i));",
   "\t\tconst gap = 3;",
   "\t\tlet min = Number(handle.min.value);",
   "\t\tlet mean = Number(handle.mean.value);",
   "\t\tlet max = Number(handle.max.value);",
   "\t\tif (el.dataset.skin === \"min\") {",
   "\t\t\tmin = Math.clamp(min, 0, 100 - gap * 2);",
   "\t\t\tmean = Math.clamp(mean, min + gap, 100 - gap);",
   "\t\t\tmax = Math.clamp(max, mean + gap, 100);",
   "\t\t} else if (el.dataset.skin === \"mean\") {",
   "\t\t\tmean = Math.clamp(mean, gap, 100 - gap);",
   "\t\t\tmin = Math.clamp(min, 0, mean - gap);",
   "\t\t\tmax = Math.clamp(max, mean + gap, 100);",
   "\t\t} else {",
   "\t\t\tmax = Math.clamp(max, gap * 2, 100);",
   "\t\t\tmean = Math.clamp(mean, gap, max - gap);",
   "\t\t\tmin = Math.clamp(min, 0, mean - gap);",
   "\t\t}",
   "\t\thandle.min.value = min;",
   "\t\thandle.mean.value = mean;",
   "\t\thandle.max.value = max;",
   "\t\tV.settings.skinToneMin = min;",
   "\t\tV.settings.skinToneMode = mean;",
   "\t\tV.settings.skinToneMax = max;",
   "\t\tsetup.colours.tintSkinToneHandles(box);",
   "\t\tsetup.colours.showSkinToneTip(el);",
   "\t},",
   "\tshowSkinToneTip(el) {",
   "\t\tconst box = el.closest(\".skinToneRange\");",
   "\t\tconst tip = box.querySelector(\".skinToneTip\");",
   "\t\tif (!tip) return;",
   "\t\tconst thumb = parseFloat(getComputedStyle(el).fontSize) * 1.15;",
   "\t\ttip.textContent = `${el.dataset.tip} — ${el.value}`;",
   "\t\ttip.style.setProperty(\"--tip-left\", `${(box.clientWidth - thumb) * (Number(el.value) / 100) + thumb / 2}px`);",
   "\t\ttip.classList.add(\"shown\");",
   "\t},",
   "\thideSkinToneTip(el) {",
   "\t\tconst tip = el.closest(\".skinToneRange\")?.querySelector(\".skinToneTip\");",
   "\t\tif (tip) tip.classList.remove(\"shown\");",
   "\t},",
   "\tsettleSkinToneTip(el) {",
   "\t\tif (!el.matches(\":hover\")) setup.colours.hideSkinToneTip(el);",
   "\t},",
   "\ttintSkinToneHandles(box) {",
   "\t\tbox.querySelectorAll(\"[data-skin]\").forEach(i =>",
   "\t\t\ti.style.setProperty(\"--skin-thumb\", setup.colours.getSkinRgb(setup.colours.skin_options.gyaru, Number(i.value) / 100))",
   "\t\t);",
   "\t},",
   "\tgetSkinToneSwatch(tone) {",
   "\t\tconst colour = setup.colours.getSkinRgb(setup.colours.skin_options.gyaru, tone / 100);",
   "\t\treturn `<span class=\"skinToneSwatch\" style=\"background:${colour}\"></span>`;",
   "\t},",
   "\tgetSkinToneLabel(tone) {",
   "\t\tif (tone === \"ghost\") return \"Ghostly Pale\";",
   "\t\tif (!Number.isFinite(tone)) return \"N/A\";",
   "\t\tif (tone < 30) return \"Light\";",
   "\t\tif (tone < 70) return \"Medium\";",
   "\t\treturn \"Dark\";"
  ],
  "context": "\t\treturn `${hueCss} ${saturationCss} ${brightnessCss}`;"
 },
