:: Widgets reaction-GreatHawk [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-greathawk-plead">>
	<<addSpeechLine "plead">>
		"나, 날 돌봐 줄 거지, 그렇지?"
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-greathawk-demand">>
	<<addSpeechLine "demand">>
		"그만 쪼아!"
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-greathawk-moan">>
	<<addSpeechLine "moan">>
		"넌 공포 같은 게 아니야. 내겐 너 하나면 돼."
	<</addSpeechLine>>
<</widget>>
