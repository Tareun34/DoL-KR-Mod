:: Widgets speech-SYDNEY [widget]
<<widget "speech-sydney">>
	<<set _npc_speech to true>>
	<<set _sydney to statusCheck("Sydney")>><<rng>>
	<<if !$sydneyUniqueComments>>
		<<set $sydneyUniqueComments to []>>
	<</if>>
	<<speechPool "Sydney">>
	<<if $speechNPCPenisVirgin or $speechNPCVaginaVirgin>>
		<<addSpeechLine "virginity">>
			<<if $speechPenisVirgin is 1 or $speechVaginaVirgin is 1 or $speechAnusVirgin is 1>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<if $sydneySeen.includes("corruptroom")>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 신음한다. "네가 나를 망가뜨리는 느낌은 매번 더 좋아져. 우린 서로의 것이야, 지금도 영원히!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 신음한다. "해냈어. 드디어 나를 더럽혔어. 우린 이제 영원히 서로의 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<<else>>
					<<if $templePromised is "Sydney">>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 헐떡인다. "우리... 우리가 해냈어... 나 너무 행복해..." <<He>>【은는】 당신을 꽉 끌어안는다. "이건 우리가 영원히 하나로 묶였다는 뜻이지... 그렇지?" <<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 헐떡인다. "이러면 안 되는데... 그런데 왜 이렇게 행복한 걸까...?" <<He>>【은는】 당신을 꽉 끌어안는다. "이건 우리가 영원히 하나로 묶였다는 뜻이지... 그렇지?" <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<</if>>
			<<else>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<if $sydneySeen.includes("corruptroom")>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 신음한다. "네가 나를 망가뜨리는 느낌은 매번 더 좋아져. 난 네 거야, 지금도 영원히!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 신음한다. "해냈어. 드디어 나를 더럽혔어. 우린 이제 영원히 서로의 것이야!" <<He>>【은는】 당신을 꽉 끌어안는다. <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<<else>>
					<<if $templePromised is "Sydney">>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 헐떡인다. "우리... 우리가 해냈어... 나 너무 행복해..." <<He>>【은는】 당신을 꽉 끌어안는다. "내가 네 첫 번째는 아니었어도... 이건 우리가 영원히 하나로 묶였다는 뜻이지... 그렇지?" <<npcincr Sydney purity -5>><<llspurity>>
					<<else>>
						<<He>>【은는】 순수한 황홀경에 젖은 얼굴로 당신을 바라보며 헐떡인다. "이러면 안 되는데... 그런데 왜 이렇게 행복한 걸까...?" <<He>>【은는】 당신을 꽉 끌어안는다. "내가 네 마지막이기만 하면, 첫 번째가 아니어도 괜찮아!" <<set $corruptionEvent to 1>><<npcincr Sydney purity -20>><<lllspurity>>
					<</if>>
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNPCAnusVirgin>>
		<<addSpeechLine "virginity">>
			<<if $speechPenisVirgin is 1>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<He>>【은는】 신음한다. "너도 이거 처음이지, 그렇지? 속도 늦추지 마. 제발!" <<He>>【은는】 <<his>> 다리로 당신을 휘감는다.
				<<else>>
					<<He>>【은는】 헐떡인다. "우, 우리 아직 순결한 거 맞아...? 기분이... 너무 좋은데..." <<He>>【은는】 당신을 꽉 끌어안는다.
				<</if>>
			<<else>>
				<<if _sydneyStatus.includes("corrupt")>>
					<<He>>【은는】 신음한다. "와, 이런 느낌일 줄은 정말 몰랐어... 계속해!" <<He>>【은는】 <<his>> 다리로 당신을 휘감는다.
				<<else>>
					<<He>>【은는】 헐떡인다. "나, 나 아직 순결한 거 맞아...? 기분이... 너무 좋은데..." <<He>>【은는】 당신을 꽉 끌어안는다.
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechOralVirgin>>
		<<addSpeechLine "virginity">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 신음하며 당신의 머리에 손을 얹는다. "이거 처음 하는 거지, 그렇지? 정말 잘하고 있어."
			<<else>>
				<<He>>【은는】 헐떡인다. "이, 이거 처음 하는 거야—" <<He>>【은는】 <<his>> 손으로 <<his>> 입을 막아 더 새어 나오려는 음란한 소리를 억누른다.
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechNPCKissVirgin>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 사랑스럽다는 듯 당신을 바라본다. "내 첫 키스였어..." <<he>>【이가】 키득거린다.
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<if _sydney.gender is "h">>
					<<He>>【은는】 숨을 들이켠다. "와! <<nnpc_Mum "Sirris">>【은는】 늘 내가 특별하다고 했는데, 너도 둘 다 있구나!"
				<<else>>
					<<He>>【은는】 숨을 들이켠다. "와! <<nnpc_Mum "Sirris">>【은는】 그게 가능하다고 한 번도 말해준 적 없는데."
				<</if>>
			<<else>>
				<<if _sydney.gender is "h">>
					<<He>>【은는】 숨을 들이켠다. "너... 너도 둘 다 있어? 나만 그런 줄 알았어!"
				<<else>>
					<<He>>【은는】 숨을 들이켠다. "두... 둘 다? 그게 가능한 줄 몰랐어!"
				<</if>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 숨을 들이켠다. "지금까지 네가 <<pcSex>>【이었였】던 거야? 음, 그래도 너에 대한 내 마음은 변하지 않아."
			<<else>>
				<<He>>【은는】 숨을 들이켠다. "너... <<pcSex>>【이】었어? 괘, 괜찮아! 그래도 널 다르게 생각하지 않아!"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $sydneyromance is 1 and $speechLINameDrop>>
		<<switch _loveInterest>>
			<<case "Black Wolf" "Great Hawk">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 멈칫한다. "도... 동물? 뭐라고?"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<case "Whitney">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 멈칫한다. "그... <<nnpc_him "Whitney">>【이가】?!"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<case "Robin" "Kylar">>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 얼어붙는다. "나... 난 너희가 그냥 친구인 줄 알았어. 그 말은...?"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
			<<default>>
				<<addSpeechLine "namedrop">>
					<<He>>【은는】 얼어붙는다. "누... 누구? 누군데?!"
					<<npcincr Sydney love -10>><<llllove>>
				<</addSpeechLine>>
		<</switch>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<addSpeechLine "sexToy">>
			<<set _sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
			<<if _sydneyStatus.includes("corrupt")>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 보고 씩 웃는다. "<<print either("아, 너랑 그걸 같이 써보는 것만큼 바라는 건 없어.","그거 할인할 때 샀지, 그렇지?")>>"
			<<elseif _sydneyStatus.includes("pure")>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 보고 얼굴을 붉힌다. "<<print either("아, 그거 <<nnpc_mum Sirris>>의 가게에서 산 거구나!","...그건 어떻게 쓰는 거야?")>>"
			<<else>>
				<<He>>【은는】 당신의 <<print _sexToy>>【을를】 보고 얼굴을 붉힌다. "이러면 안 될 것 같은데, 멈추고 싶지 않아."
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechPlayerOrgasm>>
		<<addSpeechLine "playerOrgasm">>
			<<if $speechSpank is 1>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<He>>【은는】 어리둥절한 얼굴로 당신을 내려다본다. "이건 아파야 하는 건데, 이게... 이게 뭐야?" <<npcincr Sydney purity -2>><<lspurity>>
					<<case "corrupt" "corruptLust">>
						<<He>>【은는】 당신에게 미소 지으며 키득거린다. "네가 버둥거리며 몸부림치는 걸 보니까 더 좋아." <<npcincr Sydney purity -2>><<lspurity>>
					<<default>>
						당신이 절정에 이르자 <<He>>【은는】 당황과 혼란이 뒤섞인 얼굴로 당신을 바라본다. <<npcincr Sydney purity -2>><<lspurity>>
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<if $sydneySeen.includes("player climax")>>
							<<He>>【은는】 당신에게 미소 짓는다. "내... 내가 해냈어! 내가 너를..." <<he>>【이가】 키득거린다. <<npcincr Sydney purity -2>><<lspurity>>
						<<else>>
							<<His>> 눈이 휘둥그레진다. "괘, 괜찮아? 몸이 떨리잖아!" 당신이 간신히 고개를 끄덕이자 <<he>>【은는】 진정한다. <<npcincr Sydney purity -5>><<llspurity>>
						<</if>>
					<<case "corrupt" "corruptLust">>
						<<He>>【은는】 당신에게 미소 지으며 키득거린다. "이제 내 차례야." <<npcincr Sydney purity -2>><<lspurity>>
					<<default>>
						당신이 몸을 떠는 동안 <<He>>【은는】 애정을 담아 당신에게 매달린다. <<npcincr Sydney purity -2>><<lspurity>>
				<</switch>>
			<</if>>
			<<set $sydneySeen.pushUnique("player climax")>>
		<</addSpeechLine>>
	<</if>>
	<<if playerChastity() and !$sydneySeen.includes("chastity") and $speechExposeGenitals>>
		<<addSpeechLine "expose">>
			<<if $worn.genitals.name is "chastity parasite">>
				<!-- +corruption/-purity but never +lust -->
				당신의 <<printChastity>>【을를】 보자 <<His>> 눈썹이 놀라서 치켜 올라간다. <<set _lustincrdisplay to 1>><<set _lustincr to 1>><<npcincr Sydney purity -2>><<lspurity>>
			<<else>>
				당신의 <<printChastity>>【을를】 보자 <<His>> 눈썹이 놀라서 치켜 올라간다. <<npcincr Sydney purity 2>><<gspurity>>
			<</if>>
			<<set $sydneySeen.pushUnique("chastity")>>
			<<set $sydneyUniqueComments.pushUnique("chastity")>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechSpank>>
		<<addSpeechLine "spank">>
			<<if $speechMoan is 1>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<print either(
							`<<He>>【은는】 얼굴을 붉힌다. "이, 이건 벌이란 말이야!"`,
							`<<He>>【은는】 얼굴을 붉힌다. "모르겠어, 내가 벌을 덜 세게 주고 있는 거야?"`,
							`<<He>>【은는】 얼굴을 붉힌다. "너 혹시... 이걸 즐기는 거야?" <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
					<<case "corrupt" "corruptLust">>
						<<print either(
							`<<He>>【은는】 히죽 웃는다. "너 이런 거 좋아할 줄 알았어." <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 히죽 웃는다. "못된 <<girls>>【은는】 벌을 받아야지. 난 네가 못되게 굴 때가 너무 좋아." <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 히죽 웃는다. "네 신음 소리를 음미하고 싶어. 엉덩이를 더 자주 때려줘야겠다." <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
					<<default>>
						<<print either(
							`<<He>>【은는】 입을 삐죽 내민다. "이건 훈육이란 말이야, 알아?"`,
							`<<He>>【은는】 얼굴을 붉힌다. "너 혹시... 이런 거 좋아해?" <<npcincr Sydney purity -1>><<lspurity>>`,
							`<<He>>【은는】 얼굴을 붉힌다. "이건 벌이란 말이야! 그렇게 신음하지 마!" <<npcincr Sydney purity -1>><<lspurity>>`
						)>>
				<</switch>>
			<<else>>
				<<switch _sydneyStatus>>
					<<case "pure" "pureLust">>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "내가 하든지, <<nnpc_title "Leighton">>【이가】 하든지 둘 중 하나야. 그러니까 제발 협조해 줘!"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "감히 신성한 땅을 더럽히다니!?"
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "누구도 훈육에서 예외일 순 없어!"
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "가만히 있어! 따끔하게 배워야 해!"
						<<else>>
							<<He>>【은는】 말한다. "아파야 기억에 남는 거야! 벌을 받아들여!"
						<</if>>
					<<case "corrupt" "corruptLust">>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "<<nnpc_title "Leighton">>보다는 내가 낫지, 그렇지?"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "넌 신성한 곳을 더럽혔어. 그 대가로 내가 너를 더럽혀야 할지도 모르겠네."
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "너 분명 이거 즐기고 있지."
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "이러니까 화나? 나한테 똑같이 하게 해줄지도 몰라."
						<<else>>
							<<He>>【은는】 말한다. "네가 이 고통을 즐기게 될 때까지 멈추지 않을 거야."
						<</if>>
					<<default>>
						<<if $sydneySeen.includes("spank") and $rng lte 10 and $location is "school">>
							<<He>>【은는】 말한다. "내가 하든지, <<nnpc_title "Leighton">>【이가】 하든지 둘 중 하나야. 그러니까 제발 협조해 줘!"
						<<elseif $rng lte 10 and $location is "temple">>
							<<He>>【은는】 말한다. "감히 신성한 땅을 더럽히다니!?"
						<<elseif $rng lte 35>>
							<<He>>【은는】 말한다. "오해하지 마, 이건 순전히 훈육이니까."
						<<elseif $rng lte 70>>
							<<He>>【은는】 말한다. "네가 얌전히만 있으면 이런 거 안 해도 되잖아. 난 널 아프게 하고 싶지 않아."
						<<else>>
							<<He>>【은는】 말한다. "조던한테 훈육에 대해 좀 배웠어. 이제 네가 배울 차례야."
						<</if>>
				<</switch>>
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechApologise>>
		<<addSpeechLine "apologise">>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust" "neutral" "neutralLust">>
					<<He>>【은는】 어리둥절한 표정을 짓는다. "왜 미안해해? 다 괜찮아, 정말이야."
				<<case "corrupt" "corruptLust">>
					<<He>>【은는】 말한다. "어떻게 하면 나한테 갚을 수 있는지 알려줄게."
			<</switch>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechApologiseRejected>>
		<<addSpeechLine "apologise">>
			<<switch _sydneyStatus>>
				<<case "pure" "pureLust" "neutral" "neutralLust">>
