:: Widgets reaction-Sydney [widget]

<<widget "reaction-sydney-expose">>
	<<sydneyExpose>>
<</widget>>

/* PC lines (plead / demand / moan). */

<<widget "pc-line-sydney-plead">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<addSpeechLine "plead">>
			"분명... 색욕은 죄라고 했잖아..."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "plead">>
			"미안해, 순결하게 살게! 제발 그만해!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-sydney-demand">>
	<<run statusCheck("Sydney")>>
	<<if _sydneyStatus.includes("corrupt")>>
		<<addSpeechLine "demand">>
			"네가 순결했을 때가 그립다. 그땐 적어도 이딴 짓은 안 했잖아."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "demand">>
			"이게 무슨 벌이야? 비켜!"
		<</addSpeechLine>>
	<</if>>
<</widget>>

<<widget "pc-line-sydney-moan">>
	<<run statusCheck("Sydney")>>
	<<if !_sydneyChastity>>
		<<if _sydneyStatus.includes("corrupt")>>
			<<addSpeechLine "moan">>
				"너야말로 가장 달콤한 죄악이야."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "moan">>
				"영원히, 하나로."
			<</addSpeechLine>>
		<</if>>
	<<else>>
		<<addSpeechLine "moan">>
			"네가 날 이렇게 음란하게 만들어."
		<</addSpeechLine>>
	<</if>>
<</widget>>
