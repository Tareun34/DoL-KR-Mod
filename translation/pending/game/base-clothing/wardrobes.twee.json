   "\t\tDemeanour:",
   "\t\t<<listbox \"_demeanour\" autoselect>>",
   "\t\t\t<<option \"Not set\" undefined>>",
   "\t\t\t<<optionsfrom setup.faceVariantOptions[$facestyle]>>",
   "\t\t<</listbox>>",
