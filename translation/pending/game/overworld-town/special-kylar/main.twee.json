 {
  "kind": "merged-new-text",
  "old_en": [],
  "old_kr": [],
  "new_en": [
   "",
   "<<elseif $worn.neck.name is \"love locket\" and C.npc.Kylar.love gte 10 and $rng gte 91 and !$weekly.kylarLovelocket>>",
   "\t<<set $weekly.kylarLovelocket to 1>>",
   "\t<<if $kylarLocket is \"confronted\">>",
   "\t\t<<if _kylarStatus.includes(\"Rage\")>>",
   "\t\t\tYou chat with Kylar. <<He>> stares at your locket, and gives you a baleful stare. <<npcincr Kylar rage 3>><<ggksuspicion>>",
   "\t\t<<elseif _kylarStatus.includes(\"Love\")>>",
   "\t\t\tYou chat with Kylar. <<He>> stares at your locket, face flushed with emotion. <<He>> looks at you for a long while, before turning away. <<npcincr Kylar love -3>><<lllove>>",
   "\t\t<<else>>",
   "\t\t\tYou chat with Kylar. <<He>> struggles to look in your direction for a while. <<npcincr Kylar love -1>><<llove>>",
   "\t\t<</if>>",
   "\t<<elseif $kylarLocket is \"took\">>",
   "\t\tYou chat with Kylar. <<He>> says nothing, but there's no misreading the look of unease on <<his>> face as <<he>> eyes your locket. <<stress 6>><<gstress>>",
   "\t<<elseif $kylarLocket>>",
   "\t\t<<if _kylarStatus.includes(\"Rage\")>>",
   "\t\t\t<<if $kylarLocket is \"self\">>",
   "\t\t\t\tYou chat with Kylar. <<His>> eyes flit between you and your locket with devout fervour. <<npcincr Kylar rage -3>><<llksuspicion>>",
   "\t\t\t<<elseif $kylarLocket is \"added\">>",
   "\t\t\t\tYou chat with Kylar. <<He>> keeps casting intense glances at your locket. <<stress 6>><<gstress>>",
   "\t\t\t<<else>>",
   "\t\t\t\tYou chat with Kylar. <<He>> gives your locket a baleful stare. <<npcincr Kylar rage 3>><<ggksuspicion>>",
   "\t\t\t<</if>>",
   "\t\t<<elseif _kylarStatus.includes(\"Love\")>>",
   "\t\t\t<<if $kylarLocket is \"self\">>",
   "\t\t\t\tYou chat with Kylar. <<He>> says nothing as <<he>> steals glances at your locket, but you think you see tears slowly well up. <<npcincr Kylar love 1>><<glove>>",
   "\t\t\t<<elseif $kylarLocket is \"added\">>",
   "\t\t\t\tYou chat with Kylar. <<He>> keeps casting anxious glances at your locket. <<stress 6>><<gstress>>",
   "\t\t\t<<else>>",
   "\t\t\t\tYou chat with Kylar. <<He>> is too intent on staring at your locket to look at you properly. <<npcincr Kylar rage 3>><<ggksuspicion>>",
   "\t\t\t<</if>>",
   "\t\t<<else>>",
   "\t\t\tYou chat with Kylar. <<He>> stares at you, <<his>> expression unreadable.",
   "\t\t<</if>>",
   "\t<<else>>",
   "\t\t<<set $kylarSeen.pushUnique(\"locket\")>>",
   "\t\t<<if _kylarStatus.includes(\"Rage\")>>",
   "\t\t\tYou chat with Kylar. <<He>> stares at your love locket, silent and unblinking. You're not even sure if <<hes>> breathing.",
   "\t\t<<elseif _kylarStatus.includes(\"Love\")>>",
   "\t\t\tYou chat with Kylar. <<He>> reaches forward and tries to open your locket without you noticing, but jumps back once <<he>> notices you staring.",
   "\t\t<<else>>",
   "\t\t\tYou chat with Kylar. <<He>> stares at your love locket, before turning red once <<he>> notices you staring back.",
   "\t\t<</if>>",
   "\t<</if>>"
  ],
  "context": "\t<<exit>>"
 },
