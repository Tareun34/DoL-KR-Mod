:: Widgets reaction-BlackWolf [widget]

/* PC lines (plead / demand / moan). */

<<widget "pc-line-blackwolf-plead">>
	<<addSpeechLine "plead">>
		"부드럽게, 제발..."
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-blackwolf-demand">>
	<<addSpeechLine "demand">>
		"엎드려. 엎드리라고!"
	<</addSpeechLine>>
<</widget>>

<<widget "pc-line-blackwolf-moan">>
	<<if $wolfpackleader is 1>>
		<<addSpeechLine "moan">>
			"착한 <<nnpc_gendery "Black Wolf">>【이】네. 계속해."
		<</addSpeechLine>>
	<<else>>
		<<addSpeechLine "moan">>
			"<<print ($settings.pregnancySpeechEnabled ? "임신시켜 줘" : "박아 줘")>>, 우두머리!"
		<</addSpeechLine>>
	<</if>>
<</widget>>
