				<</addSpeechLine>>
			<</if>>
		<</if>>
		<<if $consensual is 0>>
			<<addSpeechLine "withhold">>
				<<He>>【이가】 웃는다. "아직 안 끝났어, 암캐야."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNPCVaginaWithhold or $speechNPCAnusWithhold>>
		<<addSpeechLine "withhold">>
		<<speechLine>>
			<<He>>【이가】 으르렁댄다. "그만해."
		<<speechLine>>
			<<He>>【이가】 씩씩거린다. "씨발 좀 봐줘."
		<</addSpeechLine>>
		<<if $speechNPCVaginaWithhold>>
			<<addSpeechLine "withhold">>
				<<He>>【이가】 웃는다. "벌써 내가 그립지?"
			<</addSpeechLine>>
		<</if>>
		<<if $speechNPCAnusWithhold>>
			<<addSpeechLine "withhold">>
				<<He>>【이가】 웃는다. "재미는 끝났어, 걸레야."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $hairlength lt 300>>
		<<if $speechHair>>
			<<addSpeechLine "hair">>
				<<He>>【은는】 당신의 머리카락을 움켜쥔다. "얼마나 세게 당겨야 이걸 다 뽑아버릴 수 있을까."
			<</addSpeechLine>>
		<</if>>
		<<if $speechHair>>
			<<if $enemyanger lte 100>>
				<<addSpeechLine "hair">>
					"이런. 더 대머리로 만들 생각은 없었는데."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "hair">>
					"네 머리에 남은 것도 다 뜯어줄까, 창녀야?"
				<</addSpeechLine>>
			<</if>>
		<</if>>
	<<elseif $hairlength gte 700>>
		<<if $speechHair>>
			<<addSpeechLine "hair">>
				<<He>>【은는】 당신의 머리카락을 움켜쥔다. "조심해. 마음만 먹으면 널 훨씬 덜 예쁘게 만들 수 있어."
			<</addSpeechLine>>
		<</if>>
		<<if $speechHair>>
			<<if $enemyanger lte 100>>
				<<addSpeechLine "hair">>
					"얌전히 구는 게 좋을 거야, 걸레야. 내가 널 쉬운 방법으로 끌어내리는 건 싫겠지?"
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "hair">>
					"이렇게 잡아당기기 좋은 머리를 달고서 너무 암캐처럼 구네."
				<</addSpeechLine>>
			<</if>>
		<</if>>
	<<else>>
		<<if $speechHair>>
			<<addSpeechLine "hair">>
				<<He>>【은는】 당신의 머리카락을 움켜쥔다. "지금 네 머리카락으로 할 수 있는 짓들이..."
			<</addSpeechLine>>
		<</if>>
		<<if $speechHair>>
			<<if $enemyanger lte 100>>
				<<addSpeechLine "hair">>
					"네 머리 위 이 대걸레로 뭘 할까... 고민되네, 고민돼."
				<</addSpeechLine>>
			<<else>>
				<<addSpeechLine "hair">>
					"씨발 날 시험하지 마. 네 머리카락으로 아주 창의적인 짓을 하기까지 요만큼 남았어, 걸레야!"
				<</addSpeechLine>>
			<</if>>
		<</if>>
	<</if>>
	<<if $speechCoverFace>>
		<<addSpeechLine "cover">>
		<<speechLine>>
			<<He>>【이가】 음흉하게 바라본다. "어머, 왜 그래? 주목받는 걸 못 견디겠어?"
		<<speechLine>>
			<<He>>【이가】 웃는다. "계속 숨어봐. 어차피 네가 내 암캐라는 건 다들한테 말할 거니까."
		<<speechLine>>
			"너만큼 걸레인 주제에 부끄러워할 염치가 있다니."
		<</addSpeechLine>>
		<<if $audiencepresent gte 1>>
			<<addSpeechLine "cover" 4>>
				"활짝 웃어 봐, 걸레야!"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($fame.sex gte 600 or $fame.exhibitionism gte 600) and $speechCoverFace>>
		<<addSpeechLine "cover">>
			<<He>>【이가】 웃는다. "그게 도움이 될 것 같냐."
		<</addSpeechLine>>
	<</if>>
	<<if $speechCoverPenis>>
		<<addSpeechLine "cover">>
		<<speechLine>>
			<<He>>【이가】 음흉하게 바라본다. "그만둬!"
		<<speechLine>>
			"내숭 좀 그만 떨어."
		<</addSpeechLine>>
		<<if !playerHasStrapon() and $player.penissize lte 2>>
			<<addSpeechLine "cover">>
				<<He>>【이가】 웃는다. "가릴 게 뭐가 있다고?"
				<<set $whitneySeen.pushUnique("penisSmall")>><<if !$whitneyUniqueComments.includes("insecurityCoverSmall")>><<set $whitneyUniqueComments.pushUnique("insecurityCoverSmall")>><<insecurity "penis_small" 1>><<ginsecurity "penis_small">><</if>>
			<</addSpeechLine>>
		<<elseif !playerHasStrapon() and $player.penissize gte 5>>
			<<addSpeechLine "cover">>
				<<He>>【이가】 웃는다. "손이 그것보단 더 필요할 것 같은데."
				<<if !$whitneyUniqueComments.includes("insecurityCoverBig")>><<set $whitneyUniqueComments.pushUnique("insecurityCoverBig")>><<insecurity "penis_big" 1>><<ginsecurity "penis_big">><</if>>
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "cover">>
				<<He>>【이가】 웃는다. "부끄러워할 게 뭐가 있어, 걸레야?"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechCoverVagina>>
		<<addSpeechLine "cover">>
		<<speechLine>>
			<<He>>【이가】 음흉하게 바라본다. "그만둬!"
		<<speechLine>>
			<<He>>【이가】 웃는다. "뭐야? 얼마나 헐렁한지 아무한테도 보여주기 싫어?"
		<<speechLine>>
			"내숭 좀 그만 떨어."
		<</addSpeechLine>>
		<<if $arousal gte ($arousalmax / 5) * 4>>
			<<addSpeechLine "cover">>
				<<He>>【이가】 웃는다. "얼마나 젖었는지는 숨길 수 없어, 걸레야!"
			<</addSpeechLine>>
		<<elseif $arousal lt ($arousalmax / 5) * 2>>
			<<addSpeechLine "cover">>
				<<He>>【이가】 웃는다. "계속 가리고 있으면 대체 어떻게 널 젖게 만들라는 거야?"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	
	/* Idle lines */
	<<if $worn.neck.collared is 1 and C.npc.Whitney.dom gte 15>>
		<<addSpeechLine "idle">>
			<<His>> 눈이 당신의 목걸이를 내려다본다. "참 착한 <<girl>>【이】네," <<he>>【이가】 씩 웃는다. "네가 누구 건지 다들한테 알리는 거야?"
		<</addSpeechLine>>
	<</if>>
	<<if $audiencepresent gte 1>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<He>>【은는】 구경꾼들을 향해 씩 웃는다. "오늘은 내 걸레가 뭘 보여줄지 보자고." 구경꾼들이 당신 주위에서 신나게 떠들어댄다.
		<<speechLine>>
			<<He>>【은는】 구경꾼들을 돌아본다. "<<pshe>> 진짜 웃기지 않냐?" 구경꾼들이 당신 주위에서 야유한다.
		<</addSpeechLine>>
		<<if C.npc.Whitney.dom gte 15>>
			<<addSpeechLine "idle">>
			<<speechLine>>
				<<He>>【은는】 구경꾼들을 향해 씩 웃는다. "<<= either("손 떼","손 치워")>>, 변태들아. 내 걸레니까 내 규칙대로야." 구경꾼들이 장난스럽게 야유한다.
			<<speechLine>>
				<<He>>【은는】 구경꾼들을 향해 능글맞게 웃는다. "누가 사진 좀 찍어. 이건 기억해 두고 싶네." 당신 주위로 온통 휴대폰이 올라온다.
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $arousal gte ($arousalmax / 5) * 4>>
		<<addSpeechLine "idle">>
			<<He>>【이가】 낄낄거린다. "넌 사실상 애원하고 있는 거야."
		<</addSpeechLine>>
	<</if>>
	<<if $dissociation gte 1>>
		<<addSpeechLine "idle">>
			<<He>>【은는】 당신의 멍한 표정에 얼굴을 찌푸린다.
		<<speechLine>>
			"씨발 시체처럼 그냥 누워 있지 마."
		<<speechLine>>
			"여보세요? 누구 없어? 뭐라고 말 좀 해."
		<</addSpeechLine>>
	<</if>>
	<<if $pain gte 100 and $willpowerpain is 0>>
		<<addSpeechLine "idle">>
		<<speechLine>>
			<<He>>【이가】 으르렁거린다. "아프지, 안 그래?"
		<<speechLine>>
			<<He>>【이가】 낄낄거린다. "뭐야, 너무 거칠어?"
		<</addSpeechLine>>
	<</if>>
	<<if $enemyanger lte 20>>
		<<if C.npc.Whitney.dom lte 10>>
			<<addSpeechLine "idle">>
				"왜 항상 이렇게 쉽게 굴지 못하냐, 걸레야?"
			<</addSpeechLine>>
		<<elseif C.npc.Whitney.dom gte 15>>
			<<addSpeechLine "idle">>
				"거봐? 내가 시키는 대로만 하면 훨씬 쉽잖아, 걸레야."
			<</addSpeechLine>>
		<</if>>
	<<elseif $enemyanger gt 100>>
		<<if C.npc.Whitney.dom lte 10>>
			<<addSpeechLine "idle">>
				<<He>>【이가】 침을 뱉는다. "넌 씨발 뭐가 문제야?"
			<</addSpeechLine>>
		<<elseif C.npc.Whitney.dom gte 15>>
			<<addSpeechLine "idle">>
				<<He>>【이가】 침을 뱉는다. "그냥 시키는 대로 좀 하면 안 되냐, 이 <<= $player.penisExist ? "좆" : "보지">>대가리야?"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $location is "park" and $enemyanger gt 100>>
		<<addSpeechLine "idle">>
			<<He>>【이가】 으르렁거린다. "계속 그러면 널 분수에 처박아 버릴 거다!"
		<</addSpeechLine>>
	<</if>>
	<<set $_tf to checkTFparts()>>
	<<if $cow gte 6 and ($_tf.cowHorns or $_tf.cowTail)>>
		<<addSpeechLine "idle">>
			"자, 어서. 날 위해 음매 해봐!"
		<</addSpeechLine>>
	<</if>>
	<<if $cat gte 6 and ($_tf.catEars or $_tf.catTail)>>
		<<addSpeechLine "idle">>
			"자, 어서. 날 위해 가르랑거려 봐!"
		<</addSpeechLine>>
	<</if>>
	<<if $harpy gte 6 and ($_tf.birdWings or $_tf.birdTail or $_tf.birdPlumage)>>
		<<addSpeechLine "idle">>
			"자, 어서. 날 위해 노래해 봐!"
		<</addSpeechLine>>
	<</if>>
	<<if $wolfgirl gte 6 and ($_tf.wolfEars or $_tf.wolfTail)>>
		<<addSpeechLine "idle">>
			"자, 어서. 날 위해 짖어 봐!"
		<</addSpeechLine>>
	<</if>>
	<<if $fox gte 6 and ($_tf.foxEars or $_tf.foxTail)>>
		<<addSpeechLine "idle">>
			"자, 어서. 날 위해 비명 질러 봐!"
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>
