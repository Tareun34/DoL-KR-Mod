   "\t\t\t\t\t\t<<if hasSexStat(\"promiscuity\", 3)>>",
   "\t\t\t\t\t\t\t<<link [[Take a look|Flats Events Peek]]>><</link>><<promiscuous3>><<gtrauma>>",
   "\t\t\t\t\t\t\t<br>",
   "\t\t\t\t\t\t<</if>>",
   "\t\t\t\t\t\t<<link [[Wait|Flats Events Hide]]>><</link>>",
   "\t\t\t\t\t\t<br>",
   "\t\t\t\t\t\t<<link [[Leave|Flats]]>><<endevent>><<set $eventskip to 1>><</link>>",
   "\t\t\t\t\t\t<br>",
