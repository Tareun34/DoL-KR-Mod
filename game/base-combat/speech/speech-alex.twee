:: Widgets speech-Alex [widget]
<<widget "speech-alex">>
	<<set _npc_speech to true>>
	<<speechPool "Alex">>
	<<if $player.virginity.anal is "Alex" and $speechAnusVirgin>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 미소 짓는다. "조이는데. 네 엉덩이를 쓰게 해줬다는 건 아무한테도 말 안 할게."
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.oral is "Alex" and $speechOralVirgin>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 미소 짓는다. "이렇게 입을 써본 적은 없지? 이빨만 안 닿게 조심해."
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.kiss is "Alex" and $speechKissVirgin>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 미소 짓는다. "도시 <<girls>>【은는】 참 귀엽단 말이지."
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop>>
		<<if $alex_countdown is undefined and $farm_stage gte 7>>
			<<switch _loveInterest>>
				<<case "Black Wolf">>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 어깨를 늘어뜨린다. "짐승이랑 양다리를 걸친 거야? 술이 더 필요하겠어..."
					<</addSpeechLine>>
				<<case "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 노려본다. "황무지에서 뇌라도 파먹힌 거냐? 거긴 얼쩡거리지 마."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>>【은는】 노려본다. "양다리를 걸쳤어?"
					<</addSpeechLine>>
			<</switch>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Black Wolf" "Great Hawk">>
					<<addSpeechLine "namedrop">>
						"내가 술을 너무 많이 마셨나 봐," <<he>>【이가】 말한다. "말도 안 되는 소리를 다 하네."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						"내가 술을 너무 많이 마셨나 봐," <<he>>【이가】 <<his>> 이마를 짚으며 말한다.
					<</addSpeechLine>>
			<</switch>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<if C.npc.Alex.dom gte 30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 씩 웃는다. "이제야 좀 말이 통하네."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 씩 웃는다. "귀여운 장난감이네. 어떻게 쓰는지 아는 게 좋을 거야."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 씩 웃는다. "도시에선 고작 그게 최선이야?"
			<</addSpeechLine>>
		<<elseif C.npc.Alex.dom lte -30>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 머뭇거린다. "알았어. 네 판단을 믿을게."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 머뭇거린다. "그걸 어떻게 쓰는지 알고 있길 바라."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 머뭇거린다. "넌 항상 어떻게 해야 재밌는지 잘 아네."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "섹스 토이들" : "섹스 토이")>>
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 미소 짓는다. "네 생각 꽤 마음에 들어."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 미소 짓는다. "거친 밤이 될 것 같네."
			<<speechLine>>
				<<He>>【은는】 당신의 $_sexToy【을를】 보고 미소 짓는다. "도시에선 이런 게 잘 팔리나 보지."
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Alex") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Alex")>>
		<<addSpeechLine "virginity">>
			<<He>>【은는】 미소 짓는다. "처음이야? 잊지 못하게 각별히 신경 써줄게."
		<</addSpeechLine>>
	<</if>>
	<<speechSay>>
<</widget>>