				<<bHis>> 결절이 당신 안에서 꽉 조여 정액이 새어나가는 것을 막는다.
				<br><br>
			<<elseif _knotted is "mouth">>
				<<bHis>> 결절이 당신 안에서 꽉 조여 당신을 입에 재갈 물린 상태로 만든다.
				<br><br>
			<<elseif playerHasButtPlug() and $NPCList[_jj].penis is "anus">>
				당신의 $worn.butt_plug.name【이가】 정액이 새어나가는 것을 막는다.
			<<elseif $NPCList[_jj].penis is "vagina" or $NPCList[_jj].penis is "anus">>
				<<set $semenpuddle += 1>>
				<<bHis>> 자지가 빠져나온다. 막을 것이 없자 정액이 흘러나와
				<<switch Math.clamp($semenpuddle, 1,4)>>
					<<case 1>>
						당신 아래에 웅덩이를 형성한다.
					<<case 2>>
						당신 아래에 있는 웅덩이에 더해진다.
					<<case 3>>
						당신 아래에 커져가는 웅덩이에 더해진다.
					<<case 4>>
						당신 아래에 커져가는 웅덩이에 더해진다.
				<</switch>>
				<br><br>
			<</if>>
			<<if !_knotted and $settings.watersportsEnabled and $enemyanger gte random(20, 200)>>
				<<if $NPCList[_jj].type.includes("dog") or $NPCList[_jj].type.includes("wolf")>>
					<<bHe>>【이가】 한쪽 다리를 들고 당신에게 소변을 보아 <<bhis>> 영역을 표시한다.
				<<else>>
					<<bHe>>【이가】 덤으로 당신에게 소변을 보아 <<bhis>> 영역을 표시한다.
				<</if>>
				<<urinestat>>
				<br><br>
			<</if>>
		<</if>>
	<</if>>

	<!-- Index BEAST to next up -->

	<<switch $active_enemy>>
		<<case 0>>
			<<set $enemyarousal to $enemyarousal1>>
			<<set $enemyanger to $enemyanger1>>
			<<set $enemyhealth to $enemyhealth1>>
			<<set $enemytrust to $enemytrust1>>
		<<case 1>>
			<<set $enemyarousal to $enemyarousal2>>
			<<set $enemyanger to $enemyanger2>>
			<<set $enemyhealth to $enemyhealth2>>
			<<set $enemytrust to $enemytrust2>>
		<<case 2>>
			<<set $enemyarousal to $enemyarousal3>>
			<<set $enemyanger to $enemyanger3>>
			<<set $enemyhealth to $enemyhealth3>>
			<<set $enemytrust to $enemytrust3>>
		<<case 3>>
			<<set $enemyarousal to $enemyarousal4>>
			<<set $enemyanger to $enemyanger4>>
			<<set $enemyhealth to $enemyhealth4>>
			<<set $enemytrust to $enemytrust4>>
		<<case 4>>
			<<set $enemyarousal to $enemyarousal5>>
			<<set $enemyanger to $enemyanger5>>
			<<set $enemyhealth to $enemyhealth5>>
			<<set $enemytrust to $enemytrust5>>
		<<case 5>><!-- Should be unused case -->
			<<set $enemyarousal to $enemyarousal6>>
			<<set $enemyanger to $enemyanger6>>
			<<set $enemyhealth to $enemyhealth6>>
			<<set $enemytrust to $enemytrust6>>
		<<default>>
			<span class="red">ERROR: Beastejac index error</span>
	<</switch>>

	<<if $player.vaginaExist>>
		<<set $vaginause to 0>>
		<<set $vaginastate to 0>>
	<</if>>

	<<if playerHasStrapon() or $player.penisExist>>
		<<set $penisuse to 0>>
		<<set $penisstate to 0>>
	<</if>>


	<<set $mouthuse to 0>>
	<<set $anususe to 0>>
	<<unset $neckuse>>

	<<if $worn.face.type.includes("gag")>>
		<<set $mouthuse to "gagged">>
	<</if>>

	<<set $thighuse to 0>>
	<<set $bottomuse to 0>>
	<<set $feetuse to 0>>
	<<if $leftarm isnot "bound" and $position isnot "wall">>
		<<set $leftarm to 0>>
	<</if>>
	<<if $rightarm isnot "bound" and $position isnot "wall">>
		<<set $rightarm to 0>>
	<</if>>
	<<set $chestuse to 0>>
	<<set $cheststate to 0>>
	<<if $head isnot "bound" and $position isnot "wall">>
		<<set $head to 0>>
	<</if>>

	<<set $anusstate to 0>>
	<<set $mouthstate to 0>>

	<<set $leftaction to 0>>
	<<set $rightaction to 0>>
	<<set $vaginaaction to 0>>
	<<set $penisaction to 0>>
	<<set $anusaction to 0>>
	<<set $thighaction to 0>>
	<<set $cheekaction to 0>>
	<<set $feetaction to 0>>
	<<set $mouthaction to 0>>

	<<set $rapeavoid to 1>>
	<<set $ejaculating to 0>>
<</widget>>

:: Widgets Wound [widget]
<<widget "beastwound">>
	<<set $enemywounded += 1>>
	<<set $active_enemy += 1>>
	<!-- Index beasts -->

	<<switch $active_enemy>>
		<<case 0>>
			<<set $enemyarousal to $enemyarousal1>>
			<<set $enemyanger to $enemyanger1>>
			<<set $enemyhealth to $enemyhealth1>>
			<<set $enemytrust to $enemytrust1>>
		<<case 1>>
			<<set $enemyarousal to $enemyarousal2>>
			<<set $enemyanger to $enemyanger2>>
			<<set $enemyhealth to $enemyhealth2>>
			<<set $enemytrust to $enemytrust2>>
		<<case 2>>
			<<set $enemyarousal to $enemyarousal3>>
			<<set $enemyanger to $enemyanger3>>
			<<set $enemyhealth to $enemyhealth3>>
			<<set $enemytrust to $enemytrust3>>
		<<case 3>>
			<<set $enemyarousal to $enemyarousal4>>
			<<set $enemyanger to $enemyanger4>>
			<<set $enemyhealth to $enemyhealth4>>
			<<set $enemytrust to $enemytrust4>>
		<<case 4>>
			<<set $enemyarousal to $enemyarousal5>>
			<<set $enemyanger to $enemyanger5>>
			<<set $enemyhealth to $enemyhealth5>>
			<<set $enemytrust to $enemytrust5>>
		<<case 5>><!-- Should be unused case -->
			<<set $enemyarousal to $enemyarousal6>>
			<<set $enemyanger to $enemyanger6>>
			<<set $enemyhealth to $enemyhealth6>>
			<<set $enemytrust to $enemytrust6>>
		<<default>>
			<span class="red">ERROR: Beastwound index error</span>
	<</switch>>

	<<if $player.vaginaExist>>
		<<set $vaginause to 0>>
		<<set $vaginastate to 0>>
	<</if>>

	<<if playerHasStrapon() or $player.penisExist>>
		<<set $penisuse to 0>>
		<<set $penisstate to 0>>
	<</if>>

	<<set $mouthuse to 0>>
	<<set $anususe to 0>>
	<<unset $neckuse>>

	<<if $worn.face.type.includes("gag")>>
		<<set $mouthuse to "gagged">>
	<</if>>

	<<set $thighuse to 0>>
	<<set $bottomuse to 0>>
	<<set $feetuse to 0>>
	<<if $leftarm isnot "bound" and $position isnot "wall">>
		<<set $leftarm to 0>>
	<</if>>
	<<if $rightarm isnot "bound" and $position isnot "wall">>
		<<set $rightarm to 0>>
	<</if>>
	<<set $chestuse to 0>>
	<<set $cheststate to 0>>
	<<if $head isnot "bound" and $position isnot "wall">>
		<<set $head to 0>>
	<</if>>
	<<set $anusstate to 0>>
	<<set $mouthstate to 0>>

	<<set $leftaction to 0>>
	<<set $rightaction to 0>>
	<<set $vaginaaction to 0>>
	<<set $anusaction to 0>>
	<<set $thighaction to 0>>
	<<set $cheekaction to 0>>
	<<set $feetaction to 0>>
	<<set $mouthaction to 0>>

	<<set $rapeavoid to 1>>
<</widget>>

<<widget "genericCondomEjaculation">>
	<<He>>【은는】 콘돔 안에 사정한다.
	<<rng>>
	<<if $rng gte 96 and $npc[$npcrow.indexOf(_nn)] isnot "Robin" and !$npcSub and !$gloryhole and $position isnot "wall">>
		<<if $consensual is 1>>
			<<if $player.virginity.kiss is true or random(0,100) gte 60>>
				<<He>>【은는】 <<his>> <<= window.KR.getPenisDescKr($NPCList[_nn].penisdesc)>>에서 콘돔을 빼내고, 음탕한 미소를 지으며 입구를 벌려 <<his>> 손 전체에 정액을 흘려보낸다. 잠시 후, <<he>>【은는】 정액으로 미끈거리는 손가락을 당신의 입속으로 밀어 넣는다. 당신이 <<if $ejactrait is 1>>게걸스럽게<<else>>조심스럽게<</if>> 핥아 깨끗하게 만들고 나서야 <<he>>【은는】 마침내 손을 거둔다.
			<<else>>
				<<He>>【은는】 <<his>> <<= window.KR.getPenisDescKr($NPCList[_nn].penisdesc)>>에서 콘돔을 빼내고, 음탕한 미소를 지으며 자신의 입술로 가져가, 그것을 입안으로 털어 넣는다. 잠시 후, <<he>>【은는】 당신의 입술에 자신의 입술을 겹치고는, 머금었던 정액 전체를 당신의 입속으로 뱉어 넣는다. 당신이 <<if $ejactrait is 1>>게걸스럽게 삼키고 나서야<<else>>가까스로 전부 삼키고 나서야<</if>> <<he>>【은는】 마침내 입을 뗀다.
			<</if>>
		<<else>>
			<<He>>【은는】 <<his>> <<= window.KR.getPenisDescKr($NPCList[_nn].penisdesc)>>에서 콘돔을 빼내 열린 끝부분을 당신의 입속에 강제로 쑤셔 넣고는, 당신이 <<if $ejactrait is 1>>꿀꺽꿀꺽 마시는<<else>>기침하며 캑캑거리는<</if>> 모습을 보며 웃는다.
		<</if>>
		<<ejacstat>><<cumswallow `$NPCList[_nn].type` null `npcSemenMod($NPCList[_nn].penissize)`>>
	<</if>>
	/*Addition npc comments*/
<</widget>>

/* Takes NPC type to calculate volume of ejaculation to be swallowed or number to represent volume in ml. and updates stat */
<<widget "cumswallow">>
	<<set _ejaculation_volume to 0>>

	<<set _ejaculation_type to (_args[0] ? _args[0] : "human")>>

	<<if _args[1]>>
		<<set _ejaculation_volume to _args[1]>>
	<<else>>
		<<if ["human", "pc", "plant"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(5, 99)>>
		<<elseif ["wolf", "wolfboy", "wolfgirl", "dog", "dogboy", "doggirl", "fox", "foxboy", "foxgirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(5, 100)>>
		<<elseif ["centaur", "horse", "bull", "bullboy", "cow", "cowgirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(25, 250)>>
		<<elseif ["boar", "boarboy", "boargirl", "pig", "pigboy", "piggirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(50, 300)>>
		<<elseif ["bear", "bearboy", "beargirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(25, 300)>>
		<<elseif ["cat", "catboy", "catgirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(1, 15)>>
		<<elseif ["dolphin", "dolphinboy", "dolphingirl", "creature", "horned man", "horned woman", "hawk", "harpy", "lizard", "lizardboy", "lizardgirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(20, 150)>>
		<<elseif ["spider", "spiderboy", "spidergirl", "snake", "snakeboy", "snakegirl"].includes(_ejaculation_type)>>
			<<set _ejaculation_volume to random(3, 100)>>
		<<else>>
			<<run console.warn("unknown creature type passed into cumswallow: " + _ejaculation_type)>>
			<<set _ejaculation_volume to random(3, 100)>>
		<</if>>
	<</if>>
	<<switch _args[2]>>
		<<case "tiny">><<set _ejaculation_volume to Math.ceil(_ejaculation_volume / 40)>>
		<<case "large">><<set _ejaculation_volume to Math.ceil(_ejaculation_volume * 1.5)>>
	<</switch>>

	<<if _args[2] is "knotted">>
		<<if semenCountsAsHuman(_ejaculation_type)>>
			<<semenswallowedstat _ejaculation_volume>>
		<<else>>
			<<animalsemenswallowedstat _ejaculation_volume>>
		<</if>>
		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<<elseif $mouthaction is "ejacspit">>
		당신은 정액을 뱉어낸다.
	<<elseif _ejaculation_type is "pc">>
		<<if $awareness gte 200>>
			<<if _ejaculation_volume lte 10>>
				<span class="lewd">당신은 정액을 꿀꺽 삼키며, <<if $ejactrait gte 1>>적은 양에 실망감을 느낀다.<<else>>양이 적어 다행이라고 생각한다.<</if>></span>
			<<elseif _ejaculation_volume lte 30>>
				<span class="lewd">
					<<if $ejactrait gte 1>>
						당신은 익숙한 맛을 즐기며 정액을 삼킨다.
					<<else>>
						당신은 정액을 삼킨다.
					<</if>>
				</span>
			<<elseif _ejaculation_volume lte 100>>
				<span class="lewd">당신은 뺨이 빵빵해질 정도로 많은 정액을 입안에 머금고는, 꿀꺽꿀꺽 요란한 소리를 내며 삼킨다. 마침내 모조리 삼키고 나자, 당신은 <<if $ejactrait gte 1>>만족스러운 듯<<else>>안도하며<</if>> 한숨을 내쉰다.</span>
			<<else>>
				<span class="lewd">당신은 어떻게든 그 엄청난 양을 견디며, 거대한 정액의 파도를 꿀꺽 삼킨다.<<if $ejactrait gte 1 and !pcAreArmsBound("any") and $fingersInVagina is 0>> 당신은 입에서 흘러내린 정액이 낭비되는 것을 원치 않아 턱 밑에 손을 모아 받아낸다.<<else>> 흘러넘친 정액이 턱과 목을 타고 줄줄 흘러내린다. <<bodyliquid "neck" "semen">><</if>></span>
			<</if>>
		<<else>>
			<span class="red">자신의 정액을 삼키려고 애쓰는 동안 눈물이 <<print either("당신의 뺨을 타고", "당신의 얼굴을 타고")>> 흘러내린다.</span>
			<<if $ejactrait is 1>>
				당신은 입술을 핥고 싶은 충동을 억누르려 혀를 깨문다. <<lstress>><<stress -10>>
			<<else>>
				<<gstress>><<stress 10>>
			<</if>>
		<</if>>
		<<semenswallowedstat _ejaculation_volume>>
		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<<else>>
		<<if $consensual is 0 and _args[3] isnot "consensual" and _ejaculation_volume gte 3>>
			<span class="red">억지로 삼키려고 애쓰는 동안 눈물이 <<print either("당신의 뺨을 타고", "당신의 얼굴을 타고")>> 흘러내린다.</span>
			<<if $ejactrait is 1>>
				당신은 입술을 핥고 싶은 충동을 억누르려 혀를 깨문다. <<garousal>><<arousal 600>>
			<<else>>
				<<gstress>><<stress 10>>
				/*Prevents gstress from being displayed twice*/
				<<set _ejacStressDisplay to true>>
			<</if>>
			<<set _ejacStatDisplay to true>>
			<<if semenCountsAsHuman(_ejaculation_type)>>
				<<semenswallowedstat _ejaculation_volume>>
			<<else>>
				<<animalsemenswallowedstat _ejaculation_volume>>
			<</if>>
		<<else>>
			<<if _ejaculation_volume lt 3>>
				<span class="lewd">당신은 입안에 싸질러진 정액이 아무 맛도 안 느껴질 만큼 너무나 적어서 <<if $ejactrait gte 1>>실망한다.<<else>>놀란다.<</if>></span>
			<<elseif _ejaculation_volume lte 10>>
				<span class="lewd">당신은 단숨에 정액을 삼키며, <<if $ejactrait gte 1>>적은 양에 실망감을 느낀다.<<else>>양이 적어 다행이라고 생각한다.<</if>></span>
			<<elseif _ejaculation_volume lte 30>>
				<span class="lewd">
					<<if $ejactrait gte 1>>
						당신은 <<print either("강하고 쓴", "달콤하고 진한", "톡 쏘고 짭짤한")>> 맛을 즐기며 정액을 삼킨다.
					<<else>>
						당신은 정액을 삼킨다.
					<</if>>
				</span>
			<<elseif _ejaculation_volume lte 100>>
				<span class="lewd">당신은 뺨이 빵빵해질 정도로 많은 정액을 입안에 머금고는, 꿀꺽꿀꺽 요란한 소리를 내며 삼킨다. 마침내 모조리 삼키고 나자, 당신은 <<if $ejactrait gte 1>>만족스러운 듯<<else>>안도하며<</if>> 한숨을 내쉰다.</span>
			<<else>>
				<span class="lewd">당신은 엄청난 양을 감당하려 애쓰며, 삼킬 수 있는 만큼 정액을 삼킨다.<<if $ejactrait gte 1 and !pcAreArmsBound("any")>> 한 방울도 낭비하고 싶지 않아 턱 밑에 손을 모아 넘쳐흐르는 정액을 받아낸다.<<else>> 일부는 넘쳐흘러 턱과 목을 타고 흘러내린다. <</if>></span>
			<</if>>
			<<if $mouthaction is 'ejacswallow'>>
				<<if semenCountsAsHuman(_ejaculation_type)>>
					<<semenswallowedstat _ejaculation_volume>>
				<<else>>
					<<animalsemenswallowedstat _ejaculation_volume>>
				<</if>>
			<<else>>
				<<set _ejaculation_volume to Math.floor(_ejaculation_volume/3)>>
				<<if semenCountsAsHuman(_ejaculation_type)>>
					<<semenswallowedstat _ejaculation_volume>>
				<<else>>
					<<animalsemenswallowedstat _ejaculation_volume>>
				<</if>>
			<</if>>
		<</if>>

		<<set $hunger -= 200>>
		<<set $thirst -= 200>>
		<<bodyliquid "mouth" "semen" 1>>
	<</if>>
<</widget>>
