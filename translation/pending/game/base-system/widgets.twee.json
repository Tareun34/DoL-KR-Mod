  "new_en": [
   "\t<!-- 1 point of \"change\" = 1 mL of milk. The PC drinks an average of ~30 mL of milk each time \"breastfed\" is called. -->",
   "\t<<set _change to _args[0]>>",
   "",
   "\t<<if _change>>",
   "\t\t<<set $milk_drank_stat += _change>>",
   "",
   "\t\t<!-- 1 mL of milk = -1 point of $hunger. -->",
   "\t\t<<set $hunger -= _change>>",
   "",
   "\t\t<!-- 1 mL of milk = -1 point of $thirst. -->",
   "\t\t<<set $thirst -= _change>>"
  ],
  "context": "<<widget \"breastfed\">>"
 },
 {
  "kind": "merged-new-text",
  "old_en": [
   "\t\t<<set $milk_drank_stat += random(1, 5)>>"
  ],
  "old_kr": [],
  "new_en": [
   "\t\t<!-- Add 10-50 mL to the PC's \"milk_drank_stat\". -->",
   "\t\t<<set _milkDrank to random(10, 50)>>",
   "\t\t<<set $milk_drank_stat += _milkDrank>>",
   "",
   "\t\t<!-- The PC has a 30% chance of gaining transformation points when being breastfed. The point's type depends on the breast milk's source. -->"
  ],
  "context": "\t<<else>>"
 },
 {
  "kind": "merged-new-text",
  "old_en": [
   "\t\t<<if $milkdranktrait is 1>><<physique 1>><</if>>",
   "\t\t<<purity -1>>",
   "\t\t<<set $hunger -= 200>><<set $thirst -= 200>>"
  ],
  "old_kr": [],
  "new_en": [
   "",
   "\t\t<!--",
   "\t\t\tIf they have the \"Milk Addict\" / \"Milk Enthusiast\" trait, 3 mL of milk = 1 point of $physique.",
   "",
   "\t\t\tSince physique(1) = 10 $physique, divide \"milkDrank\" by 30.",
   "\t\t-->",
   "\t\t<<if $milkdranktrait is 1>><<physique `(1 / 30) * _milkDrank` \"invig\">><</if>>",
   "",
   "\t\t<!-- 30 mL of milk = -1 points of $purity. -->",
   "\t\t<<purity `(-1 / 30) * _milkDrank`>>",
   "",
   "\t\t<!-- 1 mL of milk = -1 point of $hunger. -->",
   "\t\t<<set $hunger -= _milkDrank>>",
   "",
   "\t\t<!-- 1 mL of milk = -1 point of $thirst. -->",
   "\t\t<<set $thirst -= _milkDrank>>"
  ],
  "context": "\t\t<</if>>"
 },
 {
  "kind": "merged-new-text",
  "old_en": [
   "\t<<set _nectarGain to 0>>",
   "\t<<set _nectarGain += (Math.ceil(_args[0] / 10) + random(0,2))>>",
   "\t<<set $nectar_drank_stat += _nectarGain>>",
   "\t<<set $nectar_addiction += _nectarGain>>",
   "\t<<if _args[0] gte 11>>",
   "\t\t<<purity -1>>",
   "\t<</if>>",
   "\t<<set $hunger -= (_args[0] * 5)>><<set $thirst -= (_args[0] * 5)>>",
   "\t<<drugs _args[0]>><<set $arousal += _args[0]>>"
  ],
  "old_kr": [],
  "new_en": [
   "\t<!-- 1 point of \"change\" = 1 mL of nectar. The PC drinks an average of ~10 mL of nectar each time \"nectarfed\" is called. -->",
   "\t<<set _change to _args[0]>>",
   "",
   "\t<<set $nectar_drank_stat += _change>>",
   "",
   "\t<!--",
   "\t\tThe PC needs to drink 750 mL of nectar to become an addict.",
   "",
   "\t\tSince the PC gains the \"Nectar Addict\" trait when V.nectar_addiction >= 150, 1 mL of nectar = 0.2 points of nectar addiction.",
   "\t-->",
   "\t<<set $nectar_addiction += 0.2 * _change>>",
   "",
   "\t<!-- 1 mL of nectar = -1 / 20 points of $purity. The ratio for nectar (1-to-20) is slightly higher than the ratio for milk (1-to-30) because plantpeople are more susceptible to corruption than humans. -->",
   "\t<<purity `(-1 / 20) * _change`>>",
   "",
   "\t<!-- 1 mL of nectar = -5 points of $hunger. -->",
   "\t<<set $hunger -= (_change * 5)>>",
   "",
   "\t<!-- 1 mL of nectar = -5 points of $thirst. -->",
   "\t<<set $thirst -= (_change * 5)>>",
   "",
   "\t<!--",
   "\t\tNectar is ~20% ABV, and 1 mL alcohol = 3 points of $drunk.",
   "",
   "\t\t1 mL of nectar = 0.2 mL alcohol = 0.6 points of $drunk.",
   "\t-->",
   "\t<<drunk `0.6 * _change`>>",
   "",
   "\t<!-- 1 mL of nectar = 1 point of $drugged. -->",
   "\t<<drugs _change>>",
   "",
   "\t<!-- 1 mL of nectar = 1 point of $arousal. -->",
   "\t<<set $arousal += _change>>",
   "",
   "\t<!-- Print a special message if the nectar source is ejaculating. -->"
  ],
  "context": "<<widget \"nectarfed\">>"
 },
 {
