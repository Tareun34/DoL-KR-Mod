   "",
   "function printTime(minutes, numbersOnly) {",
   "\tconst hours = Math.floor(minutes / 60);",
   "\tconst leftoverMinutes = minutes % 60;",
   "\tif (numbersOnly) {",
   "\t\t// ex: \"(0:10)\"",
   "\t\treturn \"(\" + hours + \":\" + (leftoverMinutes < 10 ? \"0\" : \"\") + leftoverMinutes + \")\";",
   "\t} else {",
   "\t\t// ex: \"5 hours and 29 minutes\"",
   "\t\tconst array = [];",
   "\t\tif (hours) array.push(`${hours} ${hours === 1 ? \"hour\" : \"hours\"}`);",
   "\t\tif (leftoverMinutes) array.push(`${leftoverMinutes} ${leftoverMinutes === 1 ? \"minute\" : \"minutes\"}`);",
   "\t\treturn array.join(\" and \");",
   "\t}",
   "}",
   "window.printTime = printTime;",
   "DefineMacroS(\"printTime\", printTime);"
  ],
  "context": "DefineMacroS(\"schoolterm\", schoolTerm);"
 }
