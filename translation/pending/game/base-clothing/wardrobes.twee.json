   "\t</div>",
   "\t<div>",
   "\t\tDefault expression:",
   "\t\t<<listbox \"_defaultSidebarMouth\" autoselect>>",
   "\t\t\t<<option \"Not set\" undefined>>",
   "\t\t\t<<option \"Smile\" \"smile\">>",
   "\t\t\t<<option \"Neutral\" \"neutral\">>",
   "\t\t<</listbox>>",
   "\t\t<mouse class=\"tooltip linkBlue\">(?)<span>'Not set' will not change your expression when you select the outfit.</span></mouse>",
   "\t</div>"
  ],
