  "new_en": [
   "\t<<set _readyBeds to [...new Set($_plotsHere.filter(plot => plot.stage === 0 && plot.till >= 1).map(plot => plot.bed))]>>",
   "\t<<set _brokenSeeds to $plants_known.filter(type => !setup.foodstuff[type])>>",
   "\t<<set _seedsByBed to {}>>",
   "\t<<run _readyBeds.forEach(bed => {",
   "\t\t_seedsByBed[bed] = V.plants_known.filter(type => {",
   "\t\t\tconst tending = setup.foodstuff[type]?.tending;",
   "\t\t\tif (!tending || tending.planting_bed !== bed) return false;",
   "\t\t\treturn tending.seasons?.includes(Time.season) || (_location === \"garden\" && V.alex_greenhouse >= 3);",
   "\t\t});",
   "\t})>>",
   "\t<<set _blockedSeeds to $plants_known.filter(type => setup.foodstuff[type]?.tending && !_readyBeds.some(bed => _seedsByBed[bed].includes(type)))>>"
  ],
  "context": "\t<</if>>"
 },
