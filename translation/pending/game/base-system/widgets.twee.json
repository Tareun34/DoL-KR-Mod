  "new_en": [
   "",
   "<<widget \"travelSpeedInfo\">>",
   "\t<<set _travelTimes to {quickly: 5, normally: 10, carefully: 30}>>",
   "\t<<if $worn.feet.type.includes(\"shackle\") and $travelSpeed is \"quickly\">>",
   "\t\t<<set $travelSpeed to \"normally\">>",
   "\t<</if>>",
   "\t<<set _speedNow to $travelSpeed>>",
   "\t<<set _travelTime to _travelTimes[_speedNow]>>",
   "\t<<set _travelTimeString to getTimeString(_travelTime)>>",
   "<</widget>>",
   "",
   "<<widget \"travelSpeedOptions\">>",
   "\t<<travelSpeedInfo>>",
   "\tHow do you want to proceed?",
   "\t<br>",
   "\t<<if $worn.feet.type.includes(\"shackle\")>>",
   "\t\t<<runicon>><span class=\"red\">Your shackles stop you from running.</span>",
   "\t<<else>>",
   "\t\t<<runicon>><label><<radiovar \"$travelSpeed\" \"quickly\">><<travelSpeedInfo>><<replace \".travelTime\">><<print _travelTimeString>><</replace>><</radiovar>> Quickly (<<print getTimeString(_travelTimes.quickly)>>)</label><<gharass>>",
   "\t<</if>>",
   "\t<br>",
   "\t<<walkicon>><label><<radiovar \"$travelSpeed\" \"normally\">><<travelSpeedInfo>><<replace \".travelTime\">><<print _travelTimeString>><</replace>><</radiovar>> Normally (<<print getTimeString(_travelTimes.normally)>>)</label>",
   "\t<br>",
   "\t<<sneakicon>><label><<radiovar \"$travelSpeed\" \"carefully\">><<travelSpeedInfo>><<replace \".travelTime\">><<print _travelTimeString>><</replace>><</radiovar>> Carefully (<<print getTimeString(_travelTimes.carefully)>>)</label><<lharass>>",
   "\t<<if $worn.feet.type.includes(\"heels\") and !$possessed>>",
   "\t\t<br>",
   "\t\t<span class=\"red\">Your heels only let you hobble, except when searching.</span>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"thuganger\">>",
   "\t<<if $rentThug>>",
   "\t\t<<if _args[0] is \"passive\" and $rentTime lt -1>>",
   "\t\t\t<<if $rentThug.anger lt 4 and $rentThug.angerCountdown lte 0>>",
   "\t\t\t\t<<set $rentThug.anger++>>",
   "\t\t\t\t<<switch $rentThug.anger>>",
   "\t\t\t\t\t<<case 2>>",
   "\t\t\t\t\t\t<<set $rentThug.angerCountdown to 1>>",
   "\t\t\t\t\t<<case 3>>",
   "\t\t\t\t\t\t<<set $rentThug.angerCountdown to 2>>",
   "\t\t\t\t\t<<default>>",
   "\t\t\t\t<</switch>>",
   "\t\t\t<<elseif $rentThug.angerCountdown gt 0>>",
   "\t\t\t\t<<set $rentThug.angerCountdown-->>",
   "\t\t\t<</if>>",
   "\t\t<<elseif Number.isInteger(_args[0])>>",
   "\t\t\t<<set $rentThug.anger to Math.clamp($rentThug.anger + _args[0], 0, 5)>>",
   "\t\t\t<<switch $rentThug.anger>>",
   "\t\t\t\t<<case 1 2>>",
   "\t\t\t\t\t<<set $rentThug.angerCountdown to 1>>",
   "\t\t\t\t<<case 3>>",
   "\t\t\t\t\t<<set $rentThug.angerCountdown to 2>>",
   "\t\t\t\t<<default>>",
   "\t\t\t<</switch>>",
   "\t\t\t<<set $rentThug.traps to []>>",
   "\t\t<</if>>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"createThugTrap\">>",
   "\t<<if $rentThug>>",
   "\t\t<<set _location to _args[0] or $bus>>",
   "\t\t/* Deletes existing trap at location */",
   "\t\t<<if $rentThug.traps.find(trap => trap.location === _location)>>",
   "\t\t\t<<set _refreshTrap to true>>",
   "\t\t\t<<set $rentThug.traps.deleteAt([$rentThug.traps.findIndex(trap => trap.location === _location)])>>",
   "\t\t<</if>>",
   "\t\t/* Sets new trap */",
   "\t\t<<set $rentThug.traps.push({",
   "\t\t\tlocation: _location,",
   "\t\t\tendTime: new DateTime(Time.date).addHours(($rentThug.anger is 5 ? 3 : 2) / (Time.dayState is \"night\" ? 2 : 1)).timeStamp",
   "\t\t})>>",
   "\t\t/* Clears old traps if needed */",
   "\t\t<<if $rentThug.traps.length gte 4>><<set $rentThug.traps.deleteAt([0])>><</if>>",
   "",
   "\t\t<<if !$settings.blindStatsEnabled>>",
   "\t\t\t<<if _refreshTrap>>",
   "\t\t\t\t<span class=\"blue\"><i>Bailey's thugs are now actively looking for you on <<print _location.toUpperFirst()>> Street. You probably shouldn't return here for some time.</i></span>",
   "\t\t\t<<else>>",
   "\t\t\t\t<span class=\"blue\"><i>Since you were seen by Bailey's thugs on <<print _location.toUpperFirst()>> Street, they are likely to be looking for you around here for some time.</i></span>",
   "\t\t\t<</if>>",
   "\t\t\t<br><br>",
   "\t\t<</if>>",
   "\t<</if>>",
   "<</widget>>"
  ],
  "context": "<</widget>>"
 },
