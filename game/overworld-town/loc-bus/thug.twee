<</if>>
<<switch $phase>>
	<<case 0>><span class="red">수상한 사람들이 당신을 똑바로 쳐다보고 있다.</span>
	<<case 1>><span class="purple">수상한 사람들이 주위를 둘러보고 있다.</span>
	<<case 2>><span class="pink">수상한 사람들이 가까이 다가오고 있다.</span>
	<<case 3>><span class="blue">수상한 사람들이 당신을 지나쳤다.</span>
	<<case 4>><span class="lblue">수상한 사람들은 아무것도 눈치채지 못했다.</span>
	<<case 5>><span class="teal">수상한 사람들이 떠나고 있다.</span>
	<<default>><span class="green">수상한 사람들이 버스에서 내렸다.</span>
<</switch>>
<br><br>
<<actionsman>>
<<if _combatend>>
	<span id="next"><<link [[다음|Bus Thug Inspection Hide Rape Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[다음|Bus Thug Inspection Hide Rape]]>><</link>></span><<nexttext>>
<</if>>

