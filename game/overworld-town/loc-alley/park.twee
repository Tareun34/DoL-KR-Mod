	카일라의 도움: <span class="green">+10%</span>
	<<set $pumpkin_win_chance += 10>>
<<elseif C.npc.Kylar.state isnot "prison" and $halloween_pumpkin_kylar is "kylar">>
	<br>
	카일라가 당신에게 잘 보이고 싶어 한다: <span class="red">-1000%</span>
	<<set $pumpkin_win_chance -= 1000>>
<</if>>
<br>
종합: <<print Math.trunc($pumpkin_win_chance)>>%
<br><br>

