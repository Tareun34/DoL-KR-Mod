:: Widgets speech-Zephyr [widget]
<<widget "speech-zephyr">>
	<<set _npc_speech to true>>
	<<if $possessed>>
		<<if $control gte $controlmax>>
			<<He>>【이가】 콧방귀를 뀐다. "이제 가봐라. 그리고 <<phim>>【을를】 가만히 내버려 둬."
		<<elseif $npcspeechcycle is 0>>
			<<He>>【이가】 망원경을 잠시 눈에 갖다 대더니 치워버린다.
		<<else>>
			<<He>>【은는】 말없이 당신을 빤히 바라본다.
		<</if>>
	<<else>>
		<<speechPool "Zephyr">>
		<<if $speechLINameDrop>>
			<<switch _loveInterest>>
				<<case "Gwylan">>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 입을 연다. "하! 우리 꼬마 바닷새는 잘 지내나?"
					<</addSpeechLine>>
				<<case "Black Wolf" "Great Hawk">>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 껄껄 웃는다. "허, 너 참 이야깃거리가 많구나."
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>>【이가】 히죽 웃는다. "뭍의 연인이냐, 바다에 바친 마음이냐. 하나만 골라."
					<</addSpeechLine>>
			<</switch>>
		<</if>>
		<<speechSay>>
	<</if>>
<</widget>>
