:: Widgets speech-Whitney [widget]
<<widget "speech-whitney">>
	<<set _npc_speech to true>>
	<<set _whitney to $NPCList.find(npc => npc.fullDescription === "Whitney")>>
	<<if !$whitneyUniqueComments>>
		<<set $whitneyUniqueComments to []>>
	<</if>>
	<<speechPool "Whitney">>
	<<if $speechFallenTransform is 1>>
		<<if $consensual is 0 and $audiencepresent gte 1>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 당신이 무너지는 걸 보고 입을 다물더니, 이내 웃음을 터뜨린다. "그딴 표정 짓지 마! 너 이거 좋아하잖아, 안 그래?"
			<</addSpeechLine>>
		<<elseif $consensual is 0>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 웃기 시작하다가, 당신이 무너지는 걸 보고 이내 얼굴을 찌푸린다. "그딴 짓 집어치워. 지금 진짜 소름 끼친다고, 걸레야."
			<</addSpeechLine>>
		<<elseif $consensual is 1>>
			<<addSpeechLine "virginity">>
				<<He>>【은는】 웃기 시작하다가, 당신이 무너지는 걸 보고 입을 다물고 불안한 눈길을 보낸다. "...야. 야!"
			<</addSpeechLine>>
		<</if>>
	<<else>>
		<<if $player.virginity.vaginal is "Whitney" and $speechVaginaVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 비웃는다. "이제 처녀란 소리는 못 듣겠네. 넌 이제 내 천박한 걸레야."
			<</addSpeechLine>>
		<</if>>
		<<if $player.virginity.penile is "Whitney" and $speechPenisVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 웃는다. "잘 봐둬, 걸레야. 내가 네 첫 상대가 되어줄 거고, 네 평생 최고의 상대가 될 테니까!"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $player.virginity.anal is "Whitney">>
		<<if $speechAnusVirgin>>
			<<addSpeechLine "virginity">>
				<<He>>【이가】 크게 웃는다. "여긴 안 된다 이거냐? 네가 뒈질 듯이 꽥꽥거리는 소릴 듣고 싶다고, <<bitch>>【아야】!"
			<</addSpeechLine>>
		<</if>>
		<<if $consensual is 1>>
			<<if $speechAnusVirgin>>
				<<addSpeechLine "virginity">>
					<<He>>【이가】 씩 웃는다. "숨 편히 쉬어, <<slut>>【아야】. 내가 너한테 하고 싶은 짓 중에선 이건 최악 축에도 못 껴."
				<</addSpeechLine>>
			<</if>>
			<<if C.npc.Whitney.love gte 20 and $speechAnusVirgin>>
				<<addSpeechLine "virginity">>
					<<He>>【이가】 씩 웃는다. "힘 빼, <<bitch>>【아야】. 넌 받아낼 수 있어."
				<</addSpeechLine>>
			<</if>>
		<</if>>
	<</if>>
	<<if $player.virginity.oral is "Whitney" and $speechOralVirgin>>
