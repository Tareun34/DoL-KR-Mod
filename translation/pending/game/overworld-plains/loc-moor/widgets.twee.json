  "new_en": [
   "",
   "<<widget \"moorTravel\">>",
   "\t<<travelSpeedInfo>>",
   "\t<<switch _speedNow>>",
   "\t\t<<case \"quickly\">><<set $forestmod to 3>><<set _huntGain to 0.5>><<set _move to \"quick\">><<set _searchMove to \"quick_search\">>",
   "\t\t<<case \"normally\">><<set $forestmod to 1>><<set _huntGain to 1>><<set _move to \"normal\">><<set _searchMove to \"normal_search\">>",
   "\t\t<<case \"carefully\">><<set $forestmod to 0.5>><<set _huntGain to 2>><<set _move to \"careful\">><<set _searchMove to \"careful_search\">>",
   "\t<</switch>>",
   "\t<<switch _args[0]>>",
   "\t\t<<case \"search\">><<set _move to _searchMove>>",
   "\t\t<<case \"deeper\">><<set $moor += 5>>",
   "\t\t<<case \"coast\">><<set $moor -= 5>>",
   "\t<</switch>>",
   "\t<<set $moormove to _move>>",
   "\t<<bird_pass _travelTime>>",
   "\t<<if $moor_hunt gte 1>><<set $moor_hunt += _huntGain>><</if>>",
   "<</widget>>",
   "",
   "<<widget \"moorShortcuts\">>",
   "\t<<if $harpy gte 6 and $birdFly gte 1 and !$plucked>>",
   "\t\tShortcuts",
   "\t\t<br>",
   "\t\t<<if $moor lt 100>>",
   "\t\t\t<<glideicon>><<link `'Fly deeper into the moor (' + getTimeString(_hoursPassed, _minutesPassed) + ')'` \"Moor\">><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<set $moor += 5>><<set $forestmod to 1>><<set $moormove to \"fly\">><</link>><<flight_text>><<gtiredness>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<<glideicon>><<link `'Fly and search nearby (' + getTimeString(_hoursPassedSearch, _minutesPassedSearch) + ')'` \"Moor\">><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTimeSearch>><<bird_pass _flightTimeSearch>><<set $forestmod to 0.5>><<set $moormove to \"fly_search\">><</link>><<flight_text>><<gtiredness>><<lharass>>",
   "\t\t<br>",
   "\t\t<<if $moor gt 0>>",
   "\t\t\t<<glideicon>><<link `'Fly towards the coast (' + getTimeString(_hoursPassed, _minutesPassed) + ')'` \"Moor\">><<set $fatigueMod to _fatigueMod>><<set $flightTime to _flightTime>><<bird_pass _flightTime>><<set $moor -= 5>><<set $forestmod to 1>><<set $moormove to \"fly\">><</link>><<flight_text>><<gtiredness>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<br>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"moorTravelIcon\">>",
   "\t<<if $moor lte 0>>",
   "\t\t<<set _depth to \"plain\">>",
   "\t<<elseif $moor lte 20>>",
   "\t\t<<set _depth to \"heather\">>",
   "\t<<elseif $moor lte 50>>",
   "\t\t<<set _depth to \"bushes\">>",
   "\t<<elseif $moor lte 99>>",
   "\t\t<<set _depth to \"wetland\">>",
   "\t<<else>>",
   "\t\t<<set _depth to \"castle\">>",
   "\t<</if>>",
