   "",
   "<<widget \"forestTravel\">>",
   "\t<<travelSpeedInfo>>",
   "\t<<switch _speedNow>>",
   "\t\t<<case \"quickly\">><<set $forestmod to 3>><<set _huntGain to 0.5>><<set _move to \"quickly\">><<set _searchMove to \"quick_search\">>",
   "\t\t<<case \"normally\">><<set $forestmod to 1.5>><<set _huntGain to 1>><<set _move to \"normally\">><<set _searchMove to \"normal_search\">>",
   "\t\t<<case \"carefully\">><<set $forestmod to 1>><<set _huntGain to 2>><<set _move to \"carefully\">><<set _searchMove to \"careful_search\">>",
   "\t<</switch>>",
   "\t<<switch _args[0]>>",
   "\t\t<<case \"search\">><<set $forest_search to true>><<set _move to _searchMove>>",
   "\t\t<<case \"deeper\">><<set $forest += 5>>",
   "\t\t<<case \"town\">><<set $forest -= 5>>",
   "\t<</switch>>",
   "\t<<set $forestmove to _move>>",
   "\t<<pass _travelTime>>",
   "\t<<if $foresthunt gte 1>><<set $foresthunt += _huntGain>><</if>>",
   "<</widget>>",
   "",
   "<<widget \"forestShortcuts\">>",
   "\t<<set _heeled to $worn.feet.type.includes(\"heels\") and !$possessed>>",
   "\t<<set _roadTime to _heeled ? 10 : 5>>",
   "\t<<set _roadDeep to $town_projects.road gte 4 and $forest lte 24>>",
   "\t<<set _roadTown to $town_projects.road gte 4 and $forest lte 25 and $forest gte 1>>",
   "\t<<set _tunnel to _args[0] is \"in\" and $historytrait gte 2 and $thicket_tunnel_intro is 1>>",
   "\t<<set _pathIn to _args[0] is \"in\" and $historytrait gte 3>>",
   "\t<<set _pathOut to _args[0] is \"out\" and $historytrait gte 3>>",
   "",
   "\t<<if _roadDeep or _roadTown or _tunnel or _pathIn or _pathOut>>",
   "\t\tShortcuts",
   "\t\t<br>",
   "\t\t<<if _roadDeep>>",
   "\t\t\t<<forestroadicon \"deep\">><<link [[Follow road deeper (<<print getTimeString(_roadTime)>>)|Forest]]>><<set $forestmod to 1>><<set $forest += 5>><<set $forestmove to \"road\">><<pass _roadTime>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<<if _roadTown>>",
   "\t\t\t\t<<forestroadicon \"town\">><<link [[Follow road towards town (<<print getTimeString(_roadTime)>>)|Forest]]>><<set $forestmod to 1>><<set $forest -= 5>><<set $forestmove to \"road\">><<pass _roadTime>><<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>><<set $eventskip to 1>><</link>><<noharass>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<<if _tunnel>>",
   "\t\t\t<<foresticon \"bush\">><<link [[Take the secret tunnel to the Residential alleyways (0:05)|Residential Thicket]]>><<pass 5>><<set $foresthunt to 0>><</link>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<<if _pathIn>>",
   "\t\t\t<<forestroadicon \"secret\">>",
   "\t\t\t<<link [[Take secret path deeper into the woods (0:10)|Forest]]>>",
   "\t\t\t\t<<set $forestmod to 1.5>><<set $forest += 50>><<set $forestmove to \"secretin\">><<pass 10>>",
   "\t\t\t\t<<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>>",
   "\t\t\t\t<<if $forestHunter is \"Gwylan\" and $foresthunt gte 1>><<set $foresthunt += 5>><</if>>",
   "\t\t\t<</link>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<<if _pathOut>>",
   "\t\t\t<<forestroadicon \"secret\">>",
   "\t\t\t<<link [[Take secret path out of the woods (0:10)|Forest]]>>",
   "\t\t\t\t<<set $forestmod to 1.5>><<set $forest -= 50>><<set $forestmove to \"secretout\">><<pass 10>>",
   "\t\t\t\t<<if $foresthunt gte 1>><<set $foresthunt += 1>><</if>>",
   "\t\t\t\t<<if $forestHunter is \"Gwylan\" and $foresthunt gte 1>><<set $foresthunt += 5>><</if>>",
   "\t\t\t<</link>>",
   "\t\t\t<br>",
   "\t\t<</if>>",
   "\t\t<br>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "",
   "/* TODO: Forest Travel Icons */",
   "<<widget \"forestTravelIcon\">>",
   "\t<<if _args[0] is \"town\">>",
   "\t\t<<if $forest lte 50>>",
   "\t\t\t<<icon \"forest-outskirts.png\">>",
   "\t\t<<else>>",
   "\t\t\t<<icon \"town-canopy.png\">>",
   "\t\t<</if>>",
   "\t<<elseif $forest lte 50>>",
   "\t\t<<icon \"forest-nature.png\">>",
   "\t<<else>>",
   "\t\t<<icon \"town-asylum.png\">>",
   "\t<</if>>",
   "<</widget>>",
   "",
   "<<widget \"foresttrail\">>",
   "\t<<generate1>><<person1>>",
   "\tYou cautiously step through the undergrowth when you hear heavy treading ahead.",
   "\t<br><br>",
   "",
   "\t<<if isLoveInterest(\"Eden\") or isLoveInterest(\"Black Wolf\")>>",
   "\t\tYou glance up expecting <<= isLoveInterest(\"Eden\") is true ? \"Eden\" : \"Black Wolf\">>, but are quickly proven wrong.",
   "\t\t<br><br>",
   "\t<</if>>",
   "",
   "\tA <<person>> trudges your way, a heavy bag slung over <<his>> shoulder. <<He>> looks out of breath, brows scrunched in frustration as <<he>> spots you and approaches. Facing <<him>> alone unnerves you slightly. <<gstress>><<stress 6>>",
   "\t<br><br>",
   "",
   "\t\"Hey, <<girl>>, you wouldn't happen to know which way the lake is, would you?\"",
   "\t<br><br>",
   "",
   "\t<<link [[Give directions|Forest Trail Encounter]]>><<set $phase to \"truth\">><</link>>",
   "\t<br>",
   "\t<<link [[Trick the stranger|Forest Trail Encounter]]>><<set $phase to \"trick\">><</link>>",
   "\t<br>",
   "\t<<link [[Say you aren't sure|Forest Trail Encounter]]>><<set $phase to \"unsure\">><</link>>",
   "\t<br>",
   "\t<<if $anxiety gte 2>>",
   "\t\t<<link [[Run away|Forest Trail Encounter]]>><<set $phase to \"run\">><</link>><<athleticsdifficulty 400 1000>> <<severe_anxiety_disorder_text>>",
   "\t\t<br>",
   "\t<</if>>",
   "<</widget>>"
  ],
  "context": "<</widget>>"
 }
