:: Widgets speech-Avery [widget]
<<widget "speech-avery">>
	<<set _avery to $NPCList.find(npc => npc.fullDescription === "Avery")>><<rng>>
	<<set _npc_speech to true>>
	<<if !$averyUniqueComments>>
		<<set $averyUniqueComments to []>>
	<</if>>
	<<if $encounterDialogue>>
		<<switch $encounterDialogue>>
			<<case "averyMansionChase">>
				<<speechPool "Avery" "noMouthAction">>
				<<averyMansionChaseSpeech>>
				<<speechSay>>
			<<case "averyUndergroundBrothel">>
				<<averyUndergroundBrothelSpeech>>
			<<case "averyHotTubVoyeur">>
				"걱정마세요, <<pcpetname "Avery">>," <<he>>【이가】 속삭인다. "그렇게 오래 쳐다보진 않을 테니까요." <<his>>의 눈에 장난스러운 빛이 스친다.
			<<default>>
				<<speechPool "Avery" "noMouthAction">>
				<<averyBaseSpeech>>
				<<speechSay>>
		<</switch>>
	<<else>>
		<<speechPool "Avery">>
		<<if $speechFallenTransform is 1 and $avery_fate is "ascended">>
			<<addSpeechLine "virginity">>
				<<if $consensual>>
