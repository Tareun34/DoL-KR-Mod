:: Widgets speech-Kylar [widget]
<<widget "speech-kylar">>
	<<set _npc_speech to true>>
	<<set _kylar to statusCheck("Kylar")>>
	<<speechPool "Kylar">>
	<<if $player.virginity.anal is "Kylar" and $speechAnusVirgin>>
		<<addSpeechLine "virginity">>
			<<if $player.vaginaExist and $settings.pregnancySpeechEnabled>>
				<<He>> gasps. "We can't make babies this way, but I just couldn't resist you."
			<<elseif !$player.vaginaExist and _kylar.gender is "m" and knowsAboutAnyPregnancy("pc","Kylar") and $settings.pregnancySpeechEnabled>>
				<<He>> gasps. "Is this how you got pregnant before? But you were still a virgin!"
			<<else>>
				<<He>> gasps. "Every part of you, the deepest part of you. I wanna feel it all!"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.oral is "Kylar" and $speechOralVirgin>>
		<<addSpeechLine "virginity">>
			<<He>> gasps. "Finally, you're kissing the most intimate part of me. Just like in my dreams!"
		<</addSpeechLine>>
	<</if>>
	<<if $player.virginity.kiss is "Kylar" and $speechKissVirgin>>
		<<addSpeechLine "virginity">>
			<<He>> gasps. "Iloveyouiloveyouiloveyou!!!"
			<<set $kylarSeen.pushUnique("saidLove")>>
		<</addSpeechLine>>
	<</if>>
	<<if $settings.pregnancySpeechEnabled and $speechCrossdressAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _kylar.gender is "h">>
				<<He>> gasps. "Oh. I thought you were..." <<He>> shakes <<his>> head with a grin. "Oh well! We can still make a family together...!"
			<<elseif $player.penisExist and (C.npc.Kylar.vagina isnot "none" or $settings.npcAnalPregnancyEnabled)>>
				<<He>> gasps. "You can make me pregnant. I'd given up on making a family, but..." <<He>> starts to cry. "You can make me pregnant...!"
			<<else>>
				<<He>> gasps. "I can make you pregnant. I'd given up on making a family, but..." <<He>> starts to cry. "I can make you pregnant...!"
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechCrossdressDisappointed is 1>>
		<<addSpeechLine "reveal">>
			<<if !$player.vaginaExist and knowsAboutAnyPregnancy("pc","Kylar")>>
				<<He>> sighs. "Oh. I thought you were..." <<He>> suddenly looks excited. "But weren't you pregnant before? Hmm, there's still a chance then."
			<<else>>
				<<He>> sighs. "Oh. I thought you were..." <<He>> shakes <<his>> head. "I-it's okay. We can always adopt."
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechHermAroused is 1>>
		<<addSpeechLine "reveal">>
			<<if _kylar.gender is "h" and $settings.pregnancySpeechEnabled>>
				<<He>> gasps. "You have both...? Just like me...? We could make so many children...perfection..."
			<<else>>
				<<He>> gasps. "You have both...? I didn't think you could get any more perfect..."
			<</if>>
		<</addSpeechLine>>
	<</if>>
	<<if $speechLINameDrop>>
		<<if _loveInterest is "Black Wolf" or _loveInterest is "Great Hawk">>
			<<addSpeechLine "namedrop">>
				<<His>> eyes narrow. "I can be an animal, too. Watch!"
				<<npcincr Kylar rage 10>><<ggksuspicion>>
			<</addSpeechLine>>
		<<else>>
			<<switch _loveInterest>>
				<<case "Robin">>
					<<addSpeechLine "namedrop">>
						<<He>> growls. "Robin can't take care of you like I can!"
						<<npcincr Kylar rage 10>><<ggksuspicion>>
					<</addSpeechLine>>
				<<case "Whitney">>
					<<addSpeechLine "namedrop">>
						<<He>> freezes. "W... Whitney can't stop me!"
						<<npcincr Kylar rage 10>><<ggksuspicion>>
					<</addSpeechLine>>
				<<case "Sydney">>
					<<addSpeechLine "namedrop">>
						<<He>> growls. "Sydney doesn't know you like I do!"
						<<set $kylarSeen.pushUnique("sydneyWriting")>>
						<<npcincr Kylar rage 10>><<ggksuspicion>>
					<</addSpeechLine>>
				<<default>>
					<<addSpeechLine "namedrop">>
						<<He>> freezes. "Who... are you talking about...?"
						<<npcincr Kylar rage 10>><<ggksuspicion>>
					<</addSpeechLine>>
			<</switch>>
			<<addSpeechLine "namedrop">>
				<<He>> freezes. "You don't need them! You only need me!"
				<<npcincr Kylar rage 10>><<ggksuspicion>>
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if $speechNoticeSexToy>>
		<<if !$player.penisExist and $NPCList[0].vagina isnot "none" and random(0,2) isnot 0>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<speechLine>>
				<<He>> looks at your $_sexToy and speaks. "U-use it. Please, use me, use it."
			<<speechLine>>
				<<He>> looks at your $_sexToy and speaks. "It's a sign of our love, right?"
			<</addSpeechLine>>
		<<elseif $player.penisExist or $NPCList[0].penis isnot "none" and random(0,2) isnot 0>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<speechLine>>
				<<He>> looks at your $_sexToy and speaks. "What... am I doing wrong...?"
			<<speechLine>>
				<<He>> looks at your $_sexToy and speaks. "If it makes you happy, my love, but..."
			<</addSpeechLine>>
		<<else>>
			<<addSpeechLine "sexToy">>
				<<set $_sexToy to ($rightarm is "heldSexToy" and $leftarm is "heldSexToy" ? "sex toys" : "sex toy")>>
			<<speechLine>>
				<<He>> looks at your $_sexToy and pouts. "Am I not good enough for you?"
			<</addSpeechLine>>
		<</if>>
	<</if>>
	<<if ($speechPenisVirgin is 1 and $player.virginity.penile is "Kylar") or ($speechVaginaVirgin is 1 and $player.virginity.vaginal is "Kylar")>>
		<<addSpeechLine "virginity">>
			<<He>> gasps. "You were a virgin too," <<he>> says. "We were meant for each other."
		<</addSpeechLine>>
	<</if>>
	<<if hasSpeechLines()>>
		<<speechSay>>
	<<elseif _silent isnot 1 and $rng gt 40>>
		<<set $kylarsexcycle to $kylarsexcycle or 0>>
		<<switch $kylarsexcycle>>
			<<case 0>>
				<<if $settings.pregnancySpeechEnabled and (playerCanBreedWith("Kylar") or (!$genderknown.includes("Kylar") and $player.gender_appearance is "f"))>>
					<<He>>【이가】 당신의 귓가에 속삭인다. "우리 아기를 아주 많이 가질 거야."
				<<else>>
					"우리 아기를 아주 많이 입양할 거야," <<he>>【이가】 말한다.
				<</if>>
			<<case 1>>
				<<print `"넌 최고의 <<pmummy>>【이가】 될 거야," <<he>>【이가】 말한다.`>>
			<<case 2>>
				"정말 야하다니까," <<he>>【이가】 말한다. "우리 아직 결혼도 안 했는데!"
			<<case 3>>
				"내 기운을 쏙 빼놓아줘," <<he>>【이가】 말한다. "그리고 멈추지 마."
			<<case 4>>
				<<print `"널 쳐다본 다른 ${$pronoun is "m" ? "개자식들" : "창년들"} 따위 전부 잊어버릴 때까지 몇 번이고 다시 할 거야," <<he>>【이가】 말한다.`>>
			<<case 5>>
				"네가 영원히 생각하는 건 나뿐일 거야," <<he>>【이가】 말한다.
			<<case 6>>
				"모두 다 나쁜 놈들이야," <<he>>【이가】 말한다. "너 빼고. 넌 완벽해."
			<<case 7>>
				"이러니까 안심돼," <<he>>【이가】 말한다. "영원히 끝나지 않았으면 좋겠어."
			<<case 8>>
				"사-사랑해," <<he>>【이가】 말한다.
				<<set $kylarSeen.pushUnique("saidLove")>>
			<<default>>
				"넌 정말 음탕하고 야해. 전부 내 거야," <<he>>【이가】 말한다.
		<</switch>>
		<<set $kylarsexcycle to ($kylarsexcycle + 1) % 10>> <!-- increase by one, and reset to 0 if it hits 10 -->
	<<else>>
		<<set _noNameComment to true>>
	<</if>>
<</widget>>
